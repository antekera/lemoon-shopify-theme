{{ 'section-lemoon-footer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-lemoon-footer.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign footer_phone = section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
  assign newsletter_form_id = 'LemoonNewsletter-' | append: section.id
-%}

{%- if section.settings.newsletter_enable -%}
  <section class="lemoon-newsletter" aria-labelledby="LemoonNewsletterHeading-{{ section.id }}">
    <div class="lemoon-footer__container lemoon-newsletter__inner">
      <div class="lemoon-newsletter__copy">
        <h2 id="LemoonNewsletterHeading-{{ section.id }}">{{ section.settings.newsletter_heading | escape }}</h2>
        {%- if section.settings.newsletter_text != blank -%}
          <p><span class="lemoon-newsletter__text--desktop">{{ section.settings.newsletter_text | escape }}</span><span class="lemoon-newsletter__text--mobile">{{ section.settings.newsletter_text_mobile | escape }}</span></p>
        {%- endif -%}
      </div>
      <div class="lemoon-newsletter__form-wrap">
        {%- form 'customer', id: newsletter_form_id, class: 'lemoon-newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="LemoonNewsletterEmail-{{ section.id }}">{{ section.settings.newsletter_placeholder | escape }}</label>
          <input
            id="LemoonNewsletterEmail-{{ section.id }}"
            class="lemoon-newsletter__input"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ section.settings.newsletter_placeholder | escape }}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            aria-required="true"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="LemoonNewsletterError-{{ section.id }}"{% elsif form.posted_successfully? %}aria-describedby="LemoonNewsletterSuccess-{{ section.id }}"{% endif %}
          >
          <button class="lemoon-newsletter__button" type="submit" name="commit">
            {{ section.settings.newsletter_button | escape }}
          </button>
          {%- if form.errors -%}
            <p id="LemoonNewsletterError-{{ section.id }}" class="lemoon-newsletter__message" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p id="LemoonNewsletterSuccess-{{ section.id }}" class="lemoon-newsletter__message" tabindex="-1">{{ section.settings.newsletter_success | escape }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </section>
{%- endif -%}

<footer class="lemoon-footer" data-lemoon-footer style="--footer-padding-top: {{ section.settings.padding_top }}px; --footer-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="lemoon-footer__container">
    <div class="lemoon-footer__main">
      <nav class="lemoon-footer__menus" aria-label="{{ section.settings.navigation_label | escape }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'navigation_column' -%}
            {%- assign menu = block.settings.menu -%}
            <details class="lemoon-footer__menu{% if block.settings.mobile_only %} lemoon-footer__menu--mobile-only{% endif %}{% if block.settings.desktop_only %} lemoon-footer__menu--desktop-only{% endif %}" data-mobile-open="{{ block.settings.open_mobile }}"{% if block.settings.open_mobile %} open{% endif %} {{ block.shopify_attributes }}>
              <summary class="lemoon-footer__menu-heading">{{ block.settings.heading | escape }}<span class="lemoon-footer__menu-toggle" aria-hidden="true"></span></summary>
            {%- if menu != blank and menu.links.size > 0 -%}
              <div class="lemoon-footer__menu-content">
                <ul class="lemoon-footer__menu-links" role="list">
                  {%- for link in menu.links -%}
                    <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
            </details>
          {%- endif -%}
        {%- endfor -%}
      </nav>
      <section class="lemoon-footer__help" aria-labelledby="LemoonHelpHeading-{{ section.id }}">
        <h2 id="LemoonHelpHeading-{{ section.id }}">{{ section.settings.help_heading | escape }}</h2>
        <p class="lemoon-footer__help-copy"><span class="lemoon-footer__help-copy--desktop">{{ section.settings.help_text | escape }}</span><span class="lemoon-footer__help-copy--mobile">{{ section.settings.help_text_mobile | escape }}</span></p>
        <div class="lemoon-footer__contact-list">
          {%- if footer_phone != blank -%}<a class="lemoon-footer__contact" href="https://wa.me/{{ footer_phone }}" target="_blank" rel="noopener" aria-label="{{ section.settings.whatsapp_label | escape }}">{%- else -%}<span class="lemoon-footer__contact" aria-label="{{ section.settings.whatsapp_label | escape }}">{%- endif -%}<span class="lemoon-footer__contact-icon" aria-hidden="true"><img src="{{ 'lemoon-icon-whatsapp.svg' | asset_url }}" alt="" width="20" height="20"></span><span>{{ section.settings.whatsapp_label | escape }}</span>{%- if footer_phone != blank -%}</a>{%- else -%}</span>{%- endif -%}
          {%- if section.settings.contact_email != blank -%}<a class="lemoon-footer__contact" href="mailto:{{ section.settings.contact_email | escape }}"><span class="lemoon-footer__contact-icon" aria-hidden="true"><img src="{{ 'lemoon-icon-email.svg' | asset_url }}" alt="" width="20" height="20"></span><span>{{ section.settings.email_label | escape }}</span></a>{%- endif -%}
        </div>
        {%- if section.settings.contact_link != blank -%}<a class="lemoon-footer__faq lemoon-footer__faq--contact" href="{{ section.settings.contact_link }}">{{ section.settings.contact_link_label | escape }} <span aria-hidden="true">↗</span></a>{%- endif -%}
      </section>
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'legal_links' and block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
        <ul class="lemoon-footer__secondary-links" role="list" {{ block.shopify_attributes }}>
          {%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endfor -%}

    <div class="lemoon-footer__follow">
      <h2>{{ section.settings.follow_heading | escape }}</h2>
      <ul class="lemoon-footer__social" role="list" aria-label="{{ section.settings.follow_heading | escape }}">
        <li>{%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}" aria-label="Facebook" target="_blank" rel="noopener">{%- else -%}<span aria-label="Facebook">{%- endif -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.4 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.6 1.6-1.6h1.7V3.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.3H7.2v3.2H10V21h3.4Z"/></svg>{%- if settings.social_facebook_link != blank -%}</a>{%- else -%}</span>{%- endif -%}</li>
        <li>{%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" aria-label="Instagram" target="_blank" rel="noopener">{%- else -%}<span aria-label="Instagram">{%- endif -%}<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.7" cy="6.6" r="1.1" fill="currentColor"/></svg>{%- if settings.social_instagram_link != blank -%}</a>{%- else -%}</span>{%- endif -%}</li>
        <li>{%- if settings.social_tiktok_link != blank -%}<a href="{{ settings.social_tiktok_link }}" aria-label="TikTok" target="_blank" rel="noopener">{%- else -%}<span aria-label="TikTok">{%- endif -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M15.4 3h-3.2v12.2a2.7 2.7 0 1 1-2.7-2.7c.4 0 .7.1 1 .2V9.4a6 6 0 1 0 4.9 5.9V9.1a8.2 8.2 0 0 0 4.8 1.6V7.5A5 5 0 0 1 15.4 3Z"/></svg>{%- if settings.social_tiktok_link != blank -%}</a>{%- else -%}</span>{%- endif -%}</li>
      </ul>
    </div>

    {%- if section.settings.payment_enable -%}
      <div class="lemoon-footer__payments">
        <h2>{{ section.settings.payment_heading | escape }}</h2>
        <ul class="lemoon-footer__payment-list" role="list">
          {%- if section.settings.payment_webpay -%}<li class="lemoon-footer__payment-badge">{{ section.settings.payment_webpay_label | escape }}</li>{%- endif -%}
          {%- if section.settings.payment_visa -%}<li class="lemoon-footer__payment-badge">{{ section.settings.payment_visa_label | escape }}</li>{%- endif -%}
          {%- if section.settings.payment_mastercard -%}<li class="lemoon-footer__payment-badge">{{ section.settings.payment_mastercard_label | escape }}</li>{%- endif -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="lemoon-footer__legal">
      <ul class="lemoon-footer__legal-links" role="list">
        {%- assign terms_page = pages['terminos-y-condiciones'] -%}
        {%- if shop.privacy_policy != blank -%}<li><a href="{{ shop.privacy_policy.url }}">Privacidad</a></li>{%- endif -%}
        {%- if shop.terms_of_service != blank -%}<li><a href="{{ shop.terms_of_service.url }}">Términos y condiciones</a></li>{%- elsif terms_page != blank -%}<li><a href="{{ terms_page.url }}">Términos y condiciones</a></li>{%- endif -%}
        {%- if section.settings.sitemap_enable -%}<li><a href="{{ routes.root_url }}sitemap.xml">Sitemap</a></li>{%- endif -%}
      </ul>
      <p class="lemoon-footer__copyright">© {{ 'now' | date: '%Y' }} Lemoon · {{ section.settings.company_name | escape }}</p>
    </div>

    <div class="lemoon-footer__art">
      {%- if section.settings.footer_art != blank -%}
        {{ section.settings.footer_art | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600, 2000, 2400', alt: section.settings.footer_art_alt, class: 'lemoon-footer__art-image' }}
      {%- else -%}
        <img class="lemoon-footer__art-image" src="{{ 'footer-abstract-transparent.png' | asset_url }}" alt="{{ section.settings.footer_art_alt | escape }}" width="2172" height="724" loading="lazy">
      {%- endif -%}
    </div>
  </div>
  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}
      {% render block %}
    {%- endif -%}
  {%- endfor -%}
</footer>

{% schema %}
{
  "name": "Footer Lemoon",
  "blocks": [
    { "type": "@app" },
    {
      "type": "navigation_column",
      "name": "Columna de enlaces",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Productos" },
        { "type": "link_list", "id": "menu", "label": "Menú" },
        { "type": "checkbox", "id": "open_mobile", "label": "Abrir al cargar en mobile", "default": false },
        { "type": "checkbox", "id": "mobile_only", "label": "Mostrar sólo en mobile", "default": false },
        { "type": "checkbox", "id": "desktop_only", "label": "Mostrar sólo en desktop", "default": false }
      ]
    },
    {
      "type": "legal_links",
      "name": "Menú legal",
      "settings": [
        { "type": "link_list", "id": "menu", "label": "Menú legal" }
      ]
    }
  ],
  "settings": [
    { "type": "checkbox", "id": "newsletter_enable", "label": "Mostrar suscripción al newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Título del newsletter", "default": "El camino para ver bien y verte bien comienza aquí." },
    { "type": "text", "id": "newsletter_text", "label": "Texto del newsletter", "default": "Recibe novedades, guías y promociones exclusivas en tu correo." },
    { "type": "text", "id": "newsletter_text_mobile", "label": "Texto del newsletter mobile", "default": "Novedades, guías y promociones exclusivas en tu correo." },
    { "type": "text", "id": "newsletter_placeholder", "label": "Texto del campo de correo", "default": "Tu correo electrónico" },
    { "type": "text", "id": "newsletter_button", "label": "Texto del botón", "default": "SUSCRIBIRME" },
    { "type": "text", "id": "newsletter_success", "label": "Mensaje de suscripción exitosa", "default": "Gracias por suscribirte." },
    { "type": "header", "content": "Ayuda y contacto" },
    { "type": "text", "id": "help_heading", "label": "Título de ayuda", "default": "¿Necesitas ayuda?" },
    { "type": "text", "id": "help_text", "label": "Texto de ayuda desktop", "default": "Estamos aquí para acompañarte en tu compra." },
    { "type": "text", "id": "help_text_mobile", "label": "Texto de ayuda mobile", "default": "Estamos aquí para ayudarte a elegir." },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp: teléfono con código de país", "info": "Ingresa sólo el número, por ejemplo 56912345678." },
    { "type": "text", "id": "whatsapp_label", "label": "Enlace de WhatsApp", "default": "Contáctanos por WhatsApp" },
    { "type": "text", "id": "contact_email", "label": "Correo de contacto", "default": "hola@lemon.cl" },
    { "type": "text", "id": "email_label", "label": "Enlace de correo", "default": "Escríbenos por correo" },
    { "type": "url", "id": "contact_link", "label": "Enlace a contáctanos" },
    { "type": "text", "id": "contact_link_label", "label": "Texto del enlace a contáctanos", "default": "Contáctanos" },
    { "type": "text", "id": "navigation_label", "label": "Etiqueta accesible para los menús", "default": "Navegación del footer" },
    { "type": "header", "content": "Redes y medios de pago" },
    { "type": "text", "id": "follow_heading", "label": "Título de redes sociales", "default": "Síguenos" },
    { "type": "checkbox", "id": "payment_enable", "label": "Mostrar medios de pago", "default": true },
    { "type": "text", "id": "payment_heading", "label": "Título de medios de pago", "default": "PAGA SEGURO CON" },
    { "type": "checkbox", "id": "payment_webpay", "label": "Mostrar Webpay", "default": true },
    { "type": "text", "id": "payment_webpay_label", "label": "Texto Webpay", "default": "Webpay" },
    { "type": "checkbox", "id": "payment_visa", "label": "Mostrar Visa", "default": true },
    { "type": "text", "id": "payment_visa_label", "label": "Texto Visa", "default": "VISA" },
    { "type": "checkbox", "id": "payment_mastercard", "label": "Mostrar Mastercard", "default": true },
    { "type": "text", "id": "payment_mastercard_label", "label": "Texto Mastercard", "default": "Mastercard" },
    { "type": "header", "content": "Información legal" },
    { "type": "checkbox", "id": "sitemap_enable", "label": "Mostrar sitemap", "default": true },
    { "type": "text", "id": "company_name", "label": "Razón social", "default": "Servigoptic SpA" },
    { "type": "header", "content": "Ilustración del footer" },
    { "type": "image_picker", "id": "footer_art", "label": "Ilustración (opcional, usa la ilustración Lemoon si se deja vacío)" },
    { "type": "text", "id": "footer_art_alt", "label": "Texto alternativo de la ilustración", "default": "Ilustración abstracta de un horizonte de limones." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espacio superior del footer", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espacio inferior del footer", "default": 0 }
  ]
}
{% endschema %}
