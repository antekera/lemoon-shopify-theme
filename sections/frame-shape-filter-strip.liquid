<nav class="lemoon-shape-filters" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="lemoon-shape-filters__inner page-width">
    {%- for block in section.blocks -%}
      {%- assign shape_url = block.settings.link | default: collection.url -%}
      {%- assign shape_filter_value = block.settings.filter_value -%}
      {%- if shape_filter_value == blank -%}
        {%- assign shape_handle = block.settings.label | handleize -%}
        {%- case shape_handle -%}
          {%- when 'rectangulares' -%}{%- assign shape_filter_value = 'Rectangular' -%}
          {%- when 'redondos' -%}{%- assign shape_filter_value = 'Redondo' -%}
          {%- when 'cat-eye' -%}{%- assign shape_filter_value = 'Cat-Eye' -%}
          {%- when 'aviador' -%}{%- assign shape_filter_value = 'Aviador' -%}
          {%- when 'oversized' -%}{%- assign shape_filter_value = 'Oversized' -%}
        {%- endcase -%}
      {%- endif -%}
      {%- if shape_filter_value != blank -%}
        {%- capture shape_url -%}{{ collection.url }}?filter.p.tag={{ shape_filter_value | url_encode }}{%- endcapture -%}
      {%- endif -%}
      <a
        class="lemoon-shape-filters__item{% if forloop.first %} is-active{% endif %}"
        href="{{ shape_url }}"
        {{ block.shopify_attributes }}
      >
        {{- block.settings.label | escape -}}
      </a>
    {%- endfor -%}
  </div>
</nav>

{% schema %}
{
  "name": "Filtro de formas",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Etiqueta accesible", "default": "Filtrar por forma de armazón" }
  ],
  "blocks": [
    {
      "type": "shape",
      "name": "Forma",
      "settings": [
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "Todos" },
        { "type": "url", "id": "link", "label": "Enlace" },
        { "type": "text", "id": "filter_value", "label": "Valor de etiqueta para filtrar", "info": "Se usa si no defines un enlace. Debe coincidir con una etiqueta de producto." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Filtro de formas", "blocks": [{ "type": "shape" }, { "type": "shape", "settings": { "label": "Rectangulares" } }, { "type": "shape", "settings": { "label": "Redondos" } }, { "type": "shape", "settings": { "label": "Cat-Eye" } }, { "type": "shape", "settings": { "label": "Aviador" } }, { "type": "shape", "settings": { "label": "Oversized" } }] }]
}
{% endschema %}
