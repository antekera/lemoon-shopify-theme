<section class="lemoon-cart-upsell">
  <div class="lemoon-cart-upsell__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="lemoon-cart-upsell__products">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        <article class="lemoon-cart-upsell__product" {{ block.shopify_attributes }}>
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 480 | image_tag: loading: 'lazy', widths: '180, 240, 360, 480', sizes: '(min-width: 750px) 240px, 45vw', alt: product.title }}
          {%- endif -%}
          <div>
            <h3>{{ product.title | default: block.settings.placeholder_title | escape }}</h3>
            {%- if product != blank -%}
              <p>{{ product.price | money }}</p>
            {%- else -%}
              <p>{{ block.settings.placeholder_price | escape }}</p>
            {%- endif -%}
          </div>
          {%- if product != blank -%}
            <a href="{{ product.url }}" class="lemoon-cart-upsell__link">{{ 'products.product.add_to_cart' | t }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Complementa tu pedido",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Completa tu pedido" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Accesorio",
      "settings": [
        { "type": "product", "id": "product", "label": "Producto" },
        { "type": "text", "id": "placeholder_title", "label": "Título si no hay producto", "default": "Estuche" },
        { "type": "text", "id": "placeholder_price", "label": "Precio si no hay producto", "default": "$9.990" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Complementa tu pedido", "blocks": [{ "type": "product" }, { "type": "product", "settings": { "placeholder_title": "Paño de limpieza" } }, { "type": "product", "settings": { "placeholder_title": "Cordón" } }] }]
}
{% endschema %}
