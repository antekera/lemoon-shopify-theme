{%- liquid
  assign has_upsell_products = false
  for block in section.blocks
    if block.settings.product != blank
      assign has_upsell_products = true
      break
    endif
  endfor
-%}

{%- if cart.item_count > 0 and has_upsell_products -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .lemoon-cart-upsell {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      color: var(--lemoon-text-primary);
      background: var(--lemoon-surface-page);
    }
    #shopify-section-{{ section.id }} .lemoon-cart-upsell__heading {
      margin: 0 0 var(--lemoon-space-6);
      font-family: var(--lemoon-font-heading);
      font-size: 2.4rem;
      font-weight: var(--lemoon-weight-semibold);
      letter-spacing: -.04rem;
    }
    #shopify-section-{{ section.id }} .lemoon-cart-upsell__products {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--lemoon-grid-gap-desktop);
      margin-top: 0;
    }
    #shopify-section-{{ section.id }} .lemoon-cart-upsell__product {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: var(--lemoon-space-4);
      min-width: 0;
      padding: var(--lemoon-card-padding);
      border: 1px solid var(--lemoon-border-default);
      border-radius: var(--lemoon-radius-md);
      background: var(--lemoon-surface-page);
    }
    #shopify-section-{{ section.id }} .lemoon-cart-upsell__image {
      display: block;
      overflow: hidden;
      aspect-ratio: 4 / 3;
      border-radius: var(--lemoon-radius-md);
      background: var(--lemoon-surface-warm);
    }
    #shopify-section-{{ section.id }} .lemoon-cart-upsell__image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    #shopify-section-{{ section.id }} .lemoon-cart-upsell__copy { padding: 0; }
    #shopify-section-{{ section.id }} .lemoon-cart-upsell__title {
      margin: 0 0 var(--lemoon-space-2);
      font-family: var(--lemoon-font-heading);
      font-size: 1.8rem;
      font-weight: var(--lemoon-weight-semibold);
    }
    #shopify-section-{{ section.id }} .lemoon-cart-upsell__title a {
      color: inherit;
      text-decoration: none;
    }
    #shopify-section-{{ section.id }} .lemoon-cart-upsell__price {
      margin: 0;
      color: var(--lemoon-text-secondary);
      font-family: var(--lemoon-font-body);
      font-size: 1.4rem;
      font-weight: var(--lemoon-weight-regular);
    }
    #shopify-section-{{ section.id }} .lemoon-cart-upsell__form {
      margin: auto 0 0;
    }
    #shopify-section-{{ section.id }} .lemoon-cart-upsell__link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 4.4rem;
      margin-top: auto;
      padding: var(--lemoon-space-3) var(--lemoon-space-4);
      border: 1px solid var(--lemoon-border-strong);
      border-radius: var(--lemoon-radius-button);
      background: var(--lemoon-surface-page);
      color: var(--lemoon-text-brand);
      font-family: var(--lemoon-font-heading);
      font-size: 1.4rem;
      font-weight: var(--lemoon-weight-semibold);
      line-height: 1.4;
      text-decoration: none;
      cursor: pointer;
    }
    #shopify-section-{{ section.id }} .lemoon-cart-upsell__link:hover {
      background: var(--lemoon-surface-warm);
    }
    #shopify-section-{{ section.id }} a:focus-visible,
    #shopify-section-{{ section.id }} button:focus-visible {
      outline: 2px solid var(--lemoon-border-strong);
      outline-offset: 4px;
    }
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .lemoon-cart-upsell__products {
        grid-template-columns: 1fr;
        gap: var(--lemoon-grid-gap-mobile);
      }
      #shopify-section-{{ section.id }} .lemoon-cart-upsell__product {
        display: grid;
        grid-template-columns: 8rem minmax(0, 1fr);
        align-items: center;
        padding: var(--lemoon-space-4);
      }
      #shopify-section-{{ section.id }} .lemoon-cart-upsell__image { aspect-ratio: 1; }
      #shopify-section-{{ section.id }} .lemoon-cart-upsell__copy:first-child { grid-column: 1 / -1; }
      #shopify-section-{{ section.id }} .lemoon-cart-upsell__form,
      #shopify-section-{{ section.id }} .lemoon-cart-upsell__product > .lemoon-cart-upsell__link {
        grid-column: 1 / -1;
      }
    }
  {%- endstyle -%}
  <div class="lemoon-cart-upsell" data-cart-upsell-section>
    <div class="lemoon-cart-upsell__inner page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="lemoon-cart-upsell__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="lemoon-cart-upsell__products">
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if product != blank -%}
            {%- liquid
              assign upsell_variant = product.selected_or_first_available_variant
              assign upsell_price = product.price | money
              assign upsell_form_id = 'CartUpsell-' | append: section.id | append: '-' | append: block.id
            -%}
            <article class="lemoon-cart-upsell__product" {{ block.shopify_attributes }}>
              {%- if product.featured_image != blank -%}
                <a class="lemoon-cart-upsell__image" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                  {{ product.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '160, 320, 480, 640', sizes: '(min-width: 990px) 360px, (min-width: 750px) 30vw, 80px', alt: '' }}
                </a>
              {%- endif -%}
              <div class="lemoon-cart-upsell__copy">
                <h3 class="lemoon-cart-upsell__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
                <p class="lemoon-cart-upsell__price">
                  {%- if product.price_varies -%}
                    {{ 'sections.cart_upsell.from_price' | t: price: upsell_price }}
                  {%- else -%}
                    {{ upsell_price }}
                  {%- endif -%}
                </p>
              </div>
              {%- if product.variants.size == 1 and upsell_variant.available -%}
                {% form 'product', product, id: upsell_form_id, class: 'lemoon-cart-upsell__form' %}
                  <input type="hidden" name="id" value="{{ upsell_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
                  <button type="submit" class="lemoon-cart-upsell__link">{{ 'sections.cart_upsell.add_to_cart' | t }}</button>
                {% endform %}
              {%- else -%}
                <a href="{{ product.url }}" class="lemoon-cart-upsell__link">{{ 'sections.cart_upsell.view_product' | t }}</a>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.cart_upsell.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.cart_upsell.settings.heading.label", "default": "t:sections.cart_upsell.settings.heading.default" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 40 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:sections.cart_upsell.blocks.product.name",
      "settings": [
        { "type": "product", "id": "product", "label": "t:sections.cart_upsell.blocks.product.settings.product.label" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "t:sections.cart_upsell.presets.name", "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }] }]
}
{% endschema %}
