{%- assign catalogue_url = routes.all_products_collection_url -%}
{%- capture json_less_than -%}\u003c{%- endcapture -%}
{{ 'lemoon-style-quiz.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} .lemoon-quiz { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .lemoon-quiz { padding-top: {{ section.settings.padding_top | times: 0.625 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.625 | round }}px; }
  }
{%- endstyle -%}
<div class="page-width">
  <div class="lemoon-quiz" data-style-quiz
    data-next-label="{{ 'sections.lemoon_style_quiz_v2.next' | t | escape }}"
    data-result-label="{{ 'sections.lemoon_style_quiz_v2.results_cta' | t | escape }}"
    data-step-label="{{ 'sections.lemoon_style_quiz_v2.step_status' | t | escape }}"
    data-error-label="{{ 'sections.lemoon_style_quiz_v2.loading_error' | t | escape }}">
    <script>
      document.currentScript.parentElement.classList.add('lemoon-quiz--enhancing');
    </script>
    <header class="lemoon-quiz__intro" data-quiz-intro>
      <div class="lemoon-quiz__invitation">
        <h1>{{ 'sections.lemoon_style_quiz_v2.title' | t }}</h1>
        <p class="lemoon-quiz__lead">{{ 'sections.lemoon_style_quiz_v2.intro' | t }}</p>
        <button type="button" class="lemoon-quiz__button" data-quiz-start disabled>{{ 'sections.lemoon_style_quiz_v2.start' | t }}{% render 'lemoon-icon', icon: 'arrow-right', size: 20 %}</button>
        <a class="lemoon-quiz__text-link" href="{{ catalogue_url | escape }}" data-quiz-catalogue>{{ 'sections.lemoon_style_quiz_v2.catalogue' | t }}</a>
      </div>
      <div class="lemoon-quiz__editorial">
        {%- if section.settings.editorial_image != blank -%}
          {{ section.settings.editorial_image | image_url: width: 1400 | image_tag: widths: '350, 650, 900, 1400', sizes: '(min-width: 990px) 46vw, 90vw', loading: 'eager' }}
        {%- else -%}
          <img
            src="{{ 'lemoon-quiz-hero-editorial-v1-1400.jpg' | asset_url }}"
            srcset="{{ 'lemoon-quiz-hero-editorial-v1-700.jpg' | asset_url }} 700w, {{ 'lemoon-quiz-hero-editorial-v1-1400.jpg' | asset_url }} 1400w"
            sizes="(min-width: 990px) 46vw, 90vw"
            width="1400"
            height="933"
            alt=""
            loading="eager"
            decoding="async"
          >
        {%- endif -%}
      </div>
    </header>
    <p class="lemoon-quiz__status" data-quiz-status role="status" aria-live="polite" aria-atomic="true"></p>
    <form class="lemoon-quiz__flow" data-quiz-form hidden>
      {%- assign stage_names = 'category,shape,color,details,use,presence' | split: ',' -%}
      <div class="lemoon-quiz__navigation">
        <div class="lemoon-quiz__progress" data-quiz-progress role="progressbar" aria-valuemin="0" aria-valuemax="6" aria-valuenow="0" aria-label="{{ 'sections.lemoon_style_quiz_v2.steps' | t | escape }}">
          {%- for stage in stage_names -%}
            <span class="lemoon-quiz__segment" data-quiz-segment="{{ stage }}" data-complete="false" aria-hidden="true"></span>
          {%- endfor -%}
        </div>
      </div>
      {%- for stage in stage_names -%}
        {%- assign stage_key = 'sections.lemoon_style_quiz_v2.stages.' | append: stage -%}
        {%- assign axis_key = 'sections.lemoon_style_quiz_v2.axes.' | append: stage -%}
        <fieldset class="lemoon-quiz__stage" data-step="{{ stage }}"{% unless forloop.first %} hidden{% endunless %}>
          <legend class="visually-hidden">{{ stage_key | append: '.title' | t }}</legend>
          <div class="lemoon-quiz__question">
            <p class="lemoon-quiz__eyebrow">{%- if stage == 'details' -%}{{ 'sections.lemoon_style_quiz_v2.details_label' | t }}{%- else -%}{{ axis_key | t }}{%- endif -%}</p>
            <h2 tabindex="-1" data-quiz-question>{{ stage_key | append: '.title' | t }}</h2>
            <p>{{ stage_key | append: '.hint' | t }}</p>
          </div>
          <div class="lemoon-quiz__choices">
            {%- case stage -%}
              {%- when 'category' -%}
                {% render 'lemoon-quiz-options', group: 'category', options: 'optical,sun', section_id: section.id %}
              {%- when 'shape' -%}
                {% render 'lemoon-quiz-options', group: 'shape', options: 'round,rectangular,cat-eye,aviator,geometric,square,oval,panto', section_id: section.id %}
              {%- when 'color' -%}
                {% render 'lemoon-quiz-options', group: 'color', options: 'bold,neutral,black,tortoise,two_tone,transparent,silver', section_id: section.id %}
              {%- when 'details' -%}
                <div class="lemoon-quiz__detail-group">
                  <h3>{{ 'sections.lemoon_style_quiz_v2.tabs.finishes' | t }}</h3>
                  {% render 'lemoon-quiz-options', group: 'finish', options: 'matte,glossy', section_id: section.id %}
                </div>
                <div class="lemoon-quiz__detail-group">
                  <h3>{{ 'sections.lemoon_style_quiz_v2.tabs.materials' | t }}</h3>
                  {% render 'lemoon-quiz-options', group: 'material', options: 'acetate,metal,titanium,tr90,wood,mixed', section_id: section.id %}
                </div>
                <p class="lemoon-quiz__hint">{{ 'sections.lemoon_style_quiz_v2.details_note' | t }}</p>
              {%- when 'use' -%}
                {% render 'lemoon-quiz-options', group: 'use', options: 'work,everyday,going_out,outdoors', section_id: section.id %}
                <p class="lemoon-quiz__hint" data-quiz-use-note data-optical-label="{{ 'sections.lemoon_style_quiz_v2.use_note' | t | escape }}" data-sun-label="{{ 'sections.lemoon_style_quiz_v2.sun_use_note' | t | escape }}">{{ 'sections.lemoon_style_quiz_v2.use_note' | t }}</p>
              {%- when 'presence' -%}
                {% render 'lemoon-quiz-options', group: 'presence', options: 'compact,medium,oversize', section_id: section.id %}
                <details class="lemoon-quiz__measures" data-quiz-measures>
                  <summary><span>{{ 'sections.lemoon_style_quiz_v2.measures.title' | t }}</span>{% render 'lemoon-icon', icon: 'chevron-down', size: 20 %}</summary>
                  <p>{{ 'sections.lemoon_style_quiz_v2.measures.intro' | t }}</p>
                  <p class="lemoon-quiz__measure-numbers">{{ 'sections.lemoon_style_quiz_v2.measures.numbers' | t }}</p>
                  <p>{{ 'sections.lemoon_style_quiz_v2.measures.labels' | t }}</p>
                  <div class="lemoon-quiz__measure-fields">
                    {%- assign measure_names = 'lens_width,bridge,temple' | split: ',' -%}
                    {%- assign measure_examples = '50,18,140' | split: ',' -%}
                    {%- for measure in measure_names -%}
                      {%- assign measure_label = 'sections.lemoon_style_quiz_v2.measures.' | append: measure -%}
                      <div>
                        <label for="QuizMeasure-{{ section.id }}-{{ measure }}">{{ measure_label | t }}</label>
                        <input id="QuizMeasure-{{ section.id }}-{{ measure }}" type="text" inputmode="numeric" maxlength="3" autocomplete="off" placeholder="{{ measure_examples[forloop.index0] }}" data-quiz-measure="{{ measure }}" aria-describedby="QuizMeasureNote-{{ section.id }} QuizMeasureStatus-{{ section.id }}">
                      </div>
                    {%- endfor -%}
                  </div>
                  <p id="QuizMeasureStatus-{{ section.id }}" class="lemoon-quiz__measure-feedback" role="status" aria-live="polite" aria-atomic="true" data-quiz-measure-status
                    data-invalid-label="{{ 'sections.lemoon_style_quiz_v2.measures.invalid' | t | escape }}"
                    data-suggestion-label="{{ 'sections.lemoon_style_quiz_v2.measures.suggestion' | t | escape }}"
                    data-manual-label="{{ 'sections.lemoon_style_quiz_v2.measures.manual' | t | escape }}"></p>
                  <p id="QuizMeasureNote-{{ section.id }}">{{ 'sections.lemoon_style_quiz_v2.measures.note' | t }}</p>
                </details>
                <p class="lemoon-quiz__hint">{{ 'sections.lemoon_style_quiz_v2.presence_note' | t }}</p>
            {%- endcase -%}
          </div>
        </fieldset>
      {%- endfor -%}
      <div class="lemoon-quiz__actions">
        <button type="button" class="lemoon-quiz__text-link" data-quiz-back>{% render 'lemoon-icon', icon: 'arrow-left', size: 20 %}{{ 'sections.lemoon_style_quiz_v2.back' | t }}</button>
        <button type="submit" class="lemoon-quiz__button" data-quiz-next>{{ 'sections.lemoon_style_quiz_v2.next' | t }}</button>
      </div>
    </form>
    <div class="lemoon-quiz__fallback" data-quiz-fallback>
      <noscript><p>{{ 'sections.lemoon_style_quiz_v2.no_js' | t }}</p></noscript>
      <a href="{{ catalogue_url | escape }}" class="lemoon-quiz__text-link" data-quiz-catalogue>{{ 'sections.lemoon_style_quiz_v2.catalogue' | t }}</a>
    </div>
    {%- paginate metaobjects.lemoon_style_trait.values by 250 -%}
      <script type="application/json" data-quiz-filter-config>
        {
          "collectionUrl": {{ catalogue_url | json }},
          "categories": {
            {%- assign category_codes = 'optical,sun' | split: ',' -%}
            {%- for category_code in category_codes -%}
              {{ category_code | json }}: [
                {%- assign category_separator = '' -%}
                {%- for product_type in shop.types -%}
                  {%- liquid
                    assign normalized_type = product_type | strip | downcase | replace: 'ó', 'o'
                    assign recognized_category = ''
                    case normalized_type
                      when 'optico', 'opticos', 'optical'
                        assign recognized_category = 'optical'
                      when 'solar', 'solares', 'lentes de sol', 'sunglasses', 'muestra solar'
                        assign recognized_category = 'sun'
                    endcase
                  -%}
                  {%- if recognized_category == category_code -%}
                    {{ category_separator }}{{ product_type | json | replace: '<', json_less_than }}
                    {%- assign category_separator = ',' -%}
                  {%- endif -%}
                {%- endfor -%}
              ]{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          },
          "availableFilters": [
            {%- for native_filter in collections['all'].filters -%}
              {{ native_filter.param_name | json }}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ],
          "dictionaryComplete": {% if paginate.pages > 1 %}false{% else %}true{% endif %},
          "traits": [
            {%- for trait in metaobjects.lemoon_style_trait.values -%}
              { "id": {{ trait.system.id | prepend: 'gid://shopify/Metaobject/' | json }}, "group": {{ trait.group.value | json | replace: '<', json_less_than }}, "code": {{ trait.code.value | json | replace: '<', json_less_than }} }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endpaginate -%}
    <script type="module" src="{{ 'lemoon-style-quiz.js' | asset_url }}" onerror="this.parentElement.classList.remove('lemoon-quiz--enhancing')"></script>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.lemoon_style_quiz_v2.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "editorial_image", "label": "t:sections.lemoon_style_quiz_v2.image_label" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64, "label": "t:sections.all.padding.padding_top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64, "label": "t:sections.all.padding.padding_bottom" }
  ],
  "presets": [{ "name": "t:sections.lemoon_style_quiz_v2.name" }]
}
{% endschema %}
