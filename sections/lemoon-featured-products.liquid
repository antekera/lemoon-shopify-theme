{%- assign featured_collection = collections[section.settings.collection] -%}

{%- if featured_collection != blank and featured_collection.products_count > 0 -%}
  <section class="lemoon-featured-products page-width">
    <div class="lemoon-featured-products__heading">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="lemoon-featured-products__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      <a href="{{ featured_collection.url }}" class="lemoon-featured-products__link lemoon-text-link">{{ section.settings.link_label | escape }}</a>
    </div>
    <ul class="lemoon-featured-products__track" role="list" aria-label="{{ section.settings.heading | escape }}">
      {%- assign displayed_count = 0 -%}
      {%- for card_product in featured_collection.products -%}
        {%- if card_product.price == 0 -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign lazy_load = false
          if displayed_count > 1
            assign lazy_load = true
          endif
          assign skip_styles = true
          if displayed_count == 0
            assign skip_styles = false
          endif
        -%}
        <li class="lemoon-featured-products__item">
          {% render 'card-product', card_product: card_product, media_aspect_ratio: 'square', show_secondary_image: true, show_vendor: false, show_rating: false, lazy_load: lazy_load, skip_styles: skip_styles, section_id: section.id %}
        </li>
        {%- assign displayed_count = displayed_count | plus: 1 -%}
        {%- if displayed_count >= section.settings.products_to_show -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
    </ul>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Destacados Lemoon",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "SELECCIÓN LEMOON" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Armazones favoritos" },
    { "type": "text", "id": "link_label", "label": "Etiqueta de enlace", "default": "Ver todos" },
    { "type": "range", "id": "products_to_show", "label": "Productos", "min": 2, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Destacados Lemoon" }]
}
{% endschema %}
