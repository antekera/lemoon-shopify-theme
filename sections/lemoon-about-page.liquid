{%- style -%}
  #shopify-section-{{ section.id }} .lemoon-about-page {
    max-width: 72rem;
    color: var(--lemoon-text-brand);
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  #shopify-section-{{ section.id }} .lemoon-about-page h1 { margin: 0 0 var(--lemoon-space-8); }
  #shopify-section-{{ section.id }} .lemoon-about-page__body {
    color: var(--lemoon-text-primary);
    font-family: var(--lemoon-font-body);
    font-size: var(--lemoon-fs-18);
    line-height: 1.7;
  }
  #shopify-section-{{ section.id }} .lemoon-about-page__body p { margin: 0 0 var(--lemoon-space-6); }
  #shopify-section-{{ section.id }} .lemoon-about-page__body p:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .lemoon-about-page__slogan {
    margin: var(--lemoon-space-8) 0 0;
    font-family: var(--lemoon-font-body);
    font-size: var(--lemoon-fs-18);
    line-height: 1.7;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .lemoon-about-page {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign about_title = 'sections.lemoon_about_page.title' | t
  assign about_title = section.settings.title | default: about_title
-%}
<div class="lemoon-about-page page-width">
  {% render 'lemoon-ui-heading', text: about_title, level: 1 %}
  <div class="lemoon-about-page__body">
    {%- if section.settings.body != blank -%}
      {{ section.settings.body }}
    {%- else -%}
      <p>{{ 'sections.lemoon_about_page.intro' | t | escape }}</p>
    {%- endif -%}
  </div>
  {%- if settings.brand_slogan != blank -%}
    <p class="lemoon-about-page__slogan">{{ settings.brand_slogan | escape }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.lemoon_about_page.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.lemoon_about_page.title_label"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:sections.lemoon_about_page.body_label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.lemoon_about_page.name"
    }
  ]
}
{% endschema %}
