{%- style -%}
  #shopify-section-{{ section.id }} .lemoon-about-page { max-width: 1280px; color: var(--lemoon-text-brand); padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  #shopify-section-{{ section.id }} .lemoon-about-page__hero { display: grid; gap: 32px; align-items: center; }
  #shopify-section-{{ section.id }} .lemoon-about-page__eyebrow { font-size: var(--lemoon-fs-12); letter-spacing: .08em; text-transform: uppercase; }
  #shopify-section-{{ section.id }} h1 { font-size: 3.4rem; font-weight: var(--lemoon-weight-light); line-height: 1.12; margin: 16px 0 24px; }
  #shopify-section-{{ section.id }} .lemoon-about-page__intro { font-size: var(--lemoon-fs-18); line-height: 1.6; color: var(--lemoon-text-secondary); max-width: 550px; }
  #shopify-section-{{ section.id }} .lemoon-about-page__visual { background: var(--lemoon-surface-warm); aspect-ratio: 1.25; border-radius: var(--lemoon-radius-modal); overflow: hidden; position: relative; margin: 0; }
  #shopify-section-{{ section.id }} .lemoon-about-page__visual img { display: block; width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .lemoon-about-page__abstract::before, #shopify-section-{{ section.id }} .lemoon-about-page__abstract::after { content: ''; position: absolute; width: 44%; aspect-ratio: 1; border: 2px solid var(--lemoon-border-strong); border-radius: 50%; top: 25%; }
  #shopify-section-{{ section.id }} .lemoon-about-page__abstract::before { left: 15%; }
  #shopify-section-{{ section.id }} .lemoon-about-page__abstract::after { right: 15%; }
  #shopify-section-{{ section.id }} .lemoon-about-page__accent { position: absolute; width: 12%; aspect-ratio: 1; border-radius: 50%; top: 12%; right: 12%; background: var(--lemoon-action-accent); }
  #shopify-section-{{ section.id }} .lemoon-about-page__links { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; margin-top: 28px; }
  #shopify-section-{{ section.id }} .lemoon-about-page__links a:not(.button) { color: inherit; text-underline-offset: 4px; min-height: var(--lemoon-size-touch); display: inline-flex; align-items: center; }
  #shopify-section-{{ section.id }} a:focus-visible { outline: 2px solid var(--lemoon-border-strong); outline-offset: 4px; }
  #shopify-section-{{ section.id }} .lemoon-about-page__values { margin-top: 64px; }
  #shopify-section-{{ section.id }} .lemoon-about-page__values > h2, #shopify-section-{{ section.id }} .lemoon-about-page__help h2 { font-size: var(--lemoon-fs-28); font-weight: var(--lemoon-weight-light); line-height: 1.25; margin: 0 0 24px; }
  #shopify-section-{{ section.id }} .lemoon-about-page__grid { display: grid; gap: 24px; }
  #shopify-section-{{ section.id }} .lemoon-about-page__value { padding: 28px; border: 1px solid var(--lemoon-border-default); border-radius: var(--lemoon-radius-modal); }
  #shopify-section-{{ section.id }} .lemoon-about-page__value h3 { font-size: var(--lemoon-fs-20); margin: 0 0 16px; }
  #shopify-section-{{ section.id }} .lemoon-about-page__value p { margin: 0; color: var(--lemoon-text-secondary); line-height: 1.6; }
  #shopify-section-{{ section.id }} .lemoon-about-page__story { max-width: 700px; margin: 64px auto 0; font-size: var(--lemoon-fs-18); line-height: 1.7; }
  #shopify-section-{{ section.id }} .lemoon-about-page__help { margin-top: 64px; background: var(--lemoon-surface-warm); border-radius: var(--lemoon-radius-modal); padding: 32px; }
  #shopify-section-{{ section.id }} .lemoon-about-page__help p { max-width: 650px; line-height: 1.6; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .lemoon-about-page { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
    #shopify-section-{{ section.id }} .lemoon-about-page__hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; }
    #shopify-section-{{ section.id }} h1 { font-size: 4.6rem; }
    #shopify-section-{{ section.id }} .lemoon-about-page__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
{%- endstyle -%}

<div class="lemoon-about-page page-width">
  <div class="lemoon-about-page__hero">
    <header>
      <span class="lemoon-about-page__eyebrow">{{ 'sections.lemoon_about_page.eyebrow' | t }}</span>
      <h1>{{ 'sections.lemoon_about_page.title' | t }}</h1>
      <p class="lemoon-about-page__intro">{{ 'sections.lemoon_about_page.intro' | t }}</p>
      <div class="lemoon-about-page__links">
        <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'sections.lemoon_about_page.catalogue' | t }}</a>
        <a href="{{ routes.root_url | append: '/pages/como-medir-tus-lentes' | replace: '//', '/' }}">{{ 'sections.lemoon_about_page.measurements' | t }}</a>
      </div>
    </header>
    {%- if section.settings.image != blank -%}
      <figure class="lemoon-about-page__visual">
        {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '375, 550, 750, 1000, 1200', sizes: '(min-width: 750px) 45vw, 90vw', loading: 'lazy' }}
      </figure>
    {%- else -%}
      <div class="lemoon-about-page__visual lemoon-about-page__abstract" aria-hidden="true"><span class="lemoon-about-page__accent"></span></div>
    {%- endif -%}
  </div>
  <section class="lemoon-about-page__values" aria-labelledby="About-values-{{ section.id }}">
    <h2 id="About-values-{{ section.id }}">{{ 'sections.lemoon_about_page.values_title' | t }}</h2>
    <div class="lemoon-about-page__grid">
      <div class="lemoon-about-page__value"><h3>{{ 'sections.lemoon_about_page.style_title' | t }}</h3><p>{{ 'sections.lemoon_about_page.style_body' | t }}</p></div>
      <div class="lemoon-about-page__value"><h3>{{ 'sections.lemoon_about_page.fit_title' | t }}</h3><p>{{ 'sections.lemoon_about_page.fit_body' | t }}</p></div>
      <div class="lemoon-about-page__value"><h3>{{ 'sections.lemoon_about_page.information_title' | t }}</h3><p>{{ 'sections.lemoon_about_page.information_body' | t }}</p></div>
    </div>
  </section>
  {%- if section.settings.demo_data -%}<div class="lemoon-about-page__story rte">{% render 'lemoon-commercial-demo', enabled: section.settings.demo_data, content: section.settings.demo_content, section_id: section.id %}</div>{%- endif -%}
  {%- if section.settings.story != blank -%}
    <div class="lemoon-about-page__story rte">{{ section.settings.story }}</div>
  {%- endif -%}
  <section class="lemoon-about-page__help" aria-labelledby="About-help-{{ section.id }}">
    <h2 id="About-help-{{ section.id }}">{{ 'sections.lemoon_about_page.help_title' | t }}</h2>
    <p>{{ 'sections.lemoon_about_page.help_body' | t }}</p>
    <div class="lemoon-about-page__links"><a href="{{ routes.root_url | append: '/pages/contact' | replace: '//', '/' }}">{{ 'sections.lemoon_about_page.contact' | t }}</a></div>
  </section>
</div>

{%- comment -%}Commercial preview copy is explicitly opt-in; disable demo_data to restore normal content.{%- endcomment -%}
{% schema %}
{
  "name": "t:sections.lemoon_about_page.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "demo_data",
      "default": false,
      "label": "t:sections.lemoon_demo.enabled_label",
      "info": "t:sections.lemoon_demo.enabled_info"
    },
    {
      "type": "richtext",
      "id": "demo_content",
      "label": "t:sections.lemoon_demo.content_label",
      "info": "t:sections.lemoon_demo.content_info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.lemoon_about_page.image_label",
      "info": "t:sections.lemoon_about_page.image_info"
    },
    {
      "type": "richtext",
      "id": "story",
      "label": "t:sections.lemoon_about_page.story_label",
      "info": "t:sections.lemoon_about_page.story_info"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.lemoon_about_page.name"
    }
  ]
}
{% endschema %}
