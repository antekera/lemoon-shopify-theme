{%- style -%}
  #shopify-section-{{ section.id }} .lemoon-not-found {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    color: var(--lemoon-text-primary);
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
    align-items: center;
    gap: var(--lemoon-space-16);
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__title {
    max-width: 52rem;
    margin: 0;
    color: var(--lemoon-text-brand);
    font-family: var(--lemoon-font-heading);
    font-size: var(--lemoon-type-h1-size);
    font-weight: var(--lemoon-type-h1-weight);
    line-height: var(--lemoon-type-h1-leading);
    letter-spacing: var(--lemoon-type-h1-tracking);
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__description {
    max-width: 48rem;
    margin: var(--lemoon-space-5) 0 var(--lemoon-space-8);
    color: var(--lemoon-text-secondary);
    font-size: 1.6rem;
    line-height: 1.6;
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--lemoon-space-3) var(--lemoon-space-6);
    margin-top: var(--lemoon-space-6);
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__links a {
    display: inline-flex;
    align-items: center;
    min-height: 4.4rem;
    color: var(--lemoon-text-brand);
    font-size: 1.4rem;
    text-decoration: underline;
    text-underline-offset: .4rem;
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 34rem;
    padding: var(--lemoon-space-6);
    border-radius: var(--lemoon-radius-modal);
    background: var(--lemoon-surface-warm);
    color: var(--lemoon-text-brand);
    font-family: var(--lemoon-font-heading);
    font-size: 8rem;
    font-weight: var(--lemoon-weight-light);
    line-height: 1;
    letter-spacing: -.3rem;
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__illustration {
    display: block;
    width: 100%;
    max-width: 42rem;
    height: auto;
    margin-bottom: var(--lemoon-space-4);
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__links a:focus-visible,
  #shopify-section-{{ section.id }} .lemoon-not-found__links a.focused {
    outline: 2px solid var(--lemoon-border-strong);
    outline-offset: 2px;
    box-shadow: none;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .lemoon-not-found__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--lemoon-space-8);
    }
    #shopify-section-{{ section.id }} .lemoon-not-found__visual {
      min-height: 0;
      font-size: 6.4rem;
    }
    #shopify-section-{{ section.id }} .lemoon-not-found__illustration {
      max-width: 28rem;
    }
  }
{%- endstyle -%}

<div class="lemoon-not-found page-width">
  <div class="lemoon-not-found__layout">
    <div class="lemoon-not-found__copy">
      <h1 id="NotFoundTitle-{{ section.id }}" class="lemoon-not-found__title">{{ 'templates.404.title' | t }}</h1>
      <p class="lemoon-not-found__description">{{ 'templates.404.description' | t }}</p>
      <nav class="lemoon-not-found__links" aria-labelledby="NotFoundTitle-{{ section.id }}">
        <a href="{{ routes.root_url }}">{{ 'templates.404.home' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}">{{ 'templates.404.catalogue' | t }}</a>
        <a href="{{ routes.root_url | append: '/pages/preguntas-frecuentes' | replace: '//', '/' }}">{{ 'templates.404.faq' | t }}</a>
        <a href="{{ routes.root_url | append: '/pages/contact' | replace: '//', '/' }}">{{ 'templates.404.contact' | t }}</a>
      </nav>
    </div>
    <div class="lemoon-not-found__visual" aria-hidden="true">
      <img
        class="lemoon-not-found__illustration"
        src="{{ 'lemoon-404-frame-lemon-v2.webp' | asset_url }}"
        width="960"
        height="640"
        alt=""
        loading="lazy"
      >
      <span>404</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 64 }
  ],
  "presets": [{ "name": "t:sections.main_404.name" }]
}
{% endschema %}
