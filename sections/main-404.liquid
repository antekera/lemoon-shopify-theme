{%- style -%}
  #shopify-section-{{ section.id }} .lemoon-not-found {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    color: var(--lemoon-text-primary);
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
    align-items: center;
    gap: var(--lemoon-space-16);
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__title {
    max-width: 52rem;
    margin: 0;
    color: var(--lemoon-text-brand);
    font-family: var(--lemoon-font-heading);
    font-size: var(--lemoon-type-h1-size);
    font-weight: var(--lemoon-type-h1-weight);
    line-height: var(--lemoon-type-h1-leading);
    letter-spacing: var(--lemoon-type-h1-tracking);
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__description {
    max-width: 48rem;
    margin: var(--lemoon-space-5) 0 var(--lemoon-space-8);
    color: var(--lemoon-text-secondary);
    font-size: 1.6rem;
    line-height: 1.6;
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__search {
    max-width: 52rem;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__label {
    display: block;
    margin-bottom: var(--lemoon-space-3);
    font-size: 1.4rem;
    font-weight: var(--lemoon-weight-medium);
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__search-row {
    display: flex;
    gap: var(--lemoon-space-3);
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__input {
    flex: 1;
    min-width: 0;
    min-height: 4.8rem;
    padding: var(--lemoon-space-3) var(--lemoon-space-5);
    border: 1px solid var(--lemoon-border-warm);
    border-radius: var(--lemoon-radius-search);
    background: var(--lemoon-surface-page);
    color: var(--lemoon-text-primary);
    font: inherit;
    font-size: 1.4rem;
    text-align: left;
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__input::placeholder {
    color: var(--lemoon-text-secondary);
    opacity: 1;
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__submit {
    min-height: 4.8rem;
    padding: var(--lemoon-space-3) var(--lemoon-space-5);
    border: 1px solid var(--lemoon-action-primary);
    border-radius: var(--lemoon-radius-button);
    background: var(--lemoon-action-primary);
    color: var(--lemoon-text-inverse);
    font-family: var(--lemoon-font-heading);
    font-size: 1.4rem;
    font-weight: var(--lemoon-weight-semibold);
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__submit:hover {
    background: var(--lemoon-action-primary-hover);
    border-color: var(--lemoon-action-primary-hover);
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--lemoon-space-3) var(--lemoon-space-6);
    margin-top: var(--lemoon-space-6);
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__links a {
    display: inline-flex;
    align-items: center;
    min-height: 4.4rem;
    color: var(--lemoon-text-brand);
    font-size: 1.4rem;
    text-decoration: underline;
    text-underline-offset: .4rem;
  }
  #shopify-section-{{ section.id }} .lemoon-not-found__visual {
    display: grid;
    place-items: center;
    min-height: 34rem;
    border-radius: var(--lemoon-radius-modal);
    background: var(--lemoon-surface-warm);
    color: var(--lemoon-text-brand);
    font-family: var(--lemoon-font-heading);
    font-size: clamp(10rem, 15vw, 20rem);
    font-weight: var(--lemoon-weight-light);
    line-height: 1;
    letter-spacing: -.6rem;
  }
  #shopify-section-{{ section.id }} .lemoon-not-found :is(a, input, button):focus-visible {
    outline: 2px solid var(--lemoon-border-strong);
    outline-offset: 4px;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .lemoon-not-found__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--lemoon-space-8);
    }
    #shopify-section-{{ section.id }} .lemoon-not-found__search-row {
      flex-direction: column;
    }
    #shopify-section-{{ section.id }} .lemoon-not-found__visual {
      min-height: 16rem;
      font-size: 10rem;
      letter-spacing: -.3rem;
    }
  }
{%- endstyle -%}

<div class="lemoon-not-found page-width">
  <div class="lemoon-not-found__layout">
    <div class="lemoon-not-found__copy">
      <h1 class="lemoon-not-found__title">{{ 'templates.404.title' | t }}</h1>
      <p class="lemoon-not-found__description">{{ 'templates.404.description' | t }}</p>
      <form class="lemoon-not-found__search" action="{{ routes.search_url }}" method="get" role="search">
        <label class="lemoon-not-found__label" for="NotFoundSearch-{{ section.id }}">{{ 'templates.404.search_label' | t }}</label>
        <div class="lemoon-not-found__search-row">
          <input
            class="lemoon-not-found__input"
            id="NotFoundSearch-{{ section.id }}"
            type="search"
            name="q"
            placeholder="{{ 'templates.404.search_placeholder' | t | escape }}"
            required
          >
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[prefix]" value="last">
          <button class="lemoon-not-found__submit" type="submit">{{ 'templates.404.search_button' | t }}</button>
        </div>
      </form>
      <div class="lemoon-not-found__links">
        <a href="{{ routes.root_url }}">{{ 'templates.404.home' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}">{{ 'templates.404.catalogue' | t }}</a>
      </div>
    </div>
    <div class="lemoon-not-found__visual" aria-hidden="true">404</div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 64 }
  ],
  "presets": [{ "name": "t:sections.main_404.name" }]
}
{% endschema %}
