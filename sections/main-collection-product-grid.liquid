{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
{{ 'lemoon-collection-plp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'lemoon-collection-plp.js' | asset_url }}" defer="defer"></script>

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: 0;
    }
    .section-{{ section.id }}-padding .lemoon-plp-main,
    .section-{{ section.id }}-padding .lemoon-plp-sidebar-body {
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign desktop_columns = section.settings.columns_desktop | at_most: 3
  assign legacy_shape = blank
  if current_tags.size == 1
    assign legacy_tag = current_tags | first | handleize
    case legacy_tag
      when 'ojo-de-gato'
        assign legacy_shape = 'ojo de gato'
      when 'geometrico'
        assign legacy_shape = 'geométrico'
      when 'redondo', 'rectangular', 'aviador', 'cuadrado', 'ovalado', 'browline', 'mariposa'
        assign legacy_shape = legacy_tag
    endcase
  endif
-%}

<collection-component view-event-payload="{{ collection | standard_event_data: 'view' | escape }}" data-collection-id="{{ collection.id }}">
  <div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {% assign current_sort = collection.sort_by | default: collection.default_sort_by %}
      {% assign initial_product_count = collection.products_count | default: 0 %}
      <div class="lemoon-plp page-width" data-collection-url="{{ collection.url }}"{% if legacy_shape != blank %} data-legacy-shape="{{ legacy_shape | escape }}"{% endif %} data-sort-prefix="{{ 'lemoon.collection.sort_prefix' | t | escape }}" data-default-columns="{{ section.settings.columns_mobile }}" style="--plp-desktop-columns: {{ desktop_columns }}; --plp-mobile-columns: {{ section.settings.columns_mobile }};">
        <div class="lemoon-plp-layout facets-vertical{% unless section.settings.enable_filtering and collection.filters != empty %} lemoon-plp-layout--no-filters{% endunless %}">
          {%- if section.settings.enable_filtering -%}
            <aside aria-labelledby="verticalTitle" class="facets-wrapper" id="main-collection-filters" data-id="{{ section.id }}">
              <div class="lemoon-plp-sidebar-header">
                {% render 'lemoon-breadcrumb', collection: collection %}
                <h2 class="facets__heading facets__heading--vertical" id="verticalTitle" tabindex="-1">{{ 'lemoon.collection.filters_title' | t }}</h2>
              </div>
              <div class="lemoon-plp-sidebar-body">
                {% render 'facets', results: collection, enable_filtering: true, enable_sorting: false, filter_type: 'vertical', paginate: paginate, lemoon_plp: true %}
              </div>
            </aside>
          {%- else -%}
            <div hidden>{% render 'facets', results: collection, enable_filtering: false, enable_sorting: false, filter_type: 'vertical', paginate: paginate, lemoon_plp: true %}</div>
          {%- endif -%}

          <div class="lemoon-plp-main">
            {%- if collection.metafields.custom.plp_promo_banner.value != blank -%}
              <div class="lemoon-plp-promo-item">
                {% render 'lemoon-collection-promo', collection: collection %}
              </div>
            {%- endif -%}
            {% render 'lemoon-collection-intro', collection: collection, show_description: section.settings.show_collection_description, show_demo_content: section.settings.show_demo_content %}
        <div class="lemoon-plp-toolbar" role="group" aria-label="{{ 'lemoon.collection.toolbar' | t }}">
          <div class="lemoon-plp-toolbar__leading">
            {%- if section.settings.enable_filtering and collection.filters != empty -%}
              <button type="button" class="lemoon-plp-filter-toggle" data-filter-toggle aria-expanded="true" aria-controls="main-collection-filters" data-label-hide="{{ 'lemoon.collection.hide_filters' | t | escape }}" data-label-show="{{ 'lemoon.collection.show_filters' | t | escape }}">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16m7-11-3 3 3 3"/></svg><span>{{ 'lemoon.collection.hide_filters' | t }}</span>
              </button>
            {%- endif -%}
          <div class="lemoon-plp-toolbar__count product-count" role="status">
            <span id="ProductCount" data-product-count="{{ initial_product_count }}" data-total-count="{{ collection.all_products_count | default: initial_product_count }}">
              {{ 'lemoon.collection.products_count' | t: count: collection.products_count }}
            </span>
          </div>

          </div>

          {%- if section.settings.enable_filtering and collection.filters != empty -%}
            <div class="lemoon-plp-drawer-slot"></div>
          {%- endif -%}

          {%- if section.settings.enable_sorting -%}
            <facet-filters-form class="lemoon-plp-sort">
              <form id="FacetSortForm" class="lemoon-plp-sort__form">
                <div class="lemoon-plp-sort-controls sorting">

                <div class="select">
                  <select name="sort_by" id="SortBy" aria-label="{{ 'products.facets.sort_by_label' | t }}" class="select__select" aria-describedby="a11y-refresh-page-message">
                    {%- assign relevance_option = collection.sort_options | where: 'value', 'most-relevant' | first -%}
                    {%- assign relevance_value = relevance_option.value | default: 'manual' -%}
                    {%- assign preferred_sorts = 'relevance,created-descending,best-selling,price-ascending,price-descending' | split: ',' -%}
                    {%- for sort_value in preferred_sorts -%}
                      {%- if sort_value == 'relevance' -%}
                        {%- assign native_value = relevance_value -%}
                        {%- assign sort_label = 'lemoon.collection.sort_relevance' | t -%}
                      {%- else -%}
                        {%- assign native_value = sort_value -%}
                        {%- case sort_value -%}
                          {%- when 'created-descending' -%}{%- assign sort_label = 'lemoon.collection.sort_newest' | t -%}
                          {%- when 'best-selling' -%}{%- assign sort_label = 'lemoon.collection.sort_best_selling' | t -%}
                          {%- when 'price-ascending' -%}{%- assign sort_label = 'lemoon.collection.sort_price_ascending' | t -%}
                          {%- when 'price-descending' -%}{%- assign sort_label = 'lemoon.collection.sort_price_descending' | t -%}
                        {%- endcase -%}
                      {%- endif -%}
                      {%- assign native_option = collection.sort_options | where: 'value', native_value | first -%}
                      {%- if native_option -%}
                        <option value="{{ native_value | escape }}" {% if native_value == current_sort %}selected{% endif %}>{{ sort_label }}</option>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- unless current_sort == relevance_value or preferred_sorts contains current_sort -%}
                      {%- assign current_option = collection.sort_options | where: 'value', current_sort | first -%}
                      {%- if current_option -%}<option value="{{ current_sort | escape }}" selected>{{ current_option.name | escape }}</option>{%- endif -%}
                    {%- endunless -%}
                  </select>
                  <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                </div>
                <details class="lemoon-sort-menu" data-sort-menu>
                  <summary role="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="SortOptions-{{ section.id }}"><span data-sort-label></span><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></summary>
                  <div id="SortOptions-{{ section.id }}" class="lemoon-sort-menu__options" role="listbox" aria-label="{{ 'products.facets.sort_by_label' | t }}" data-sort-options></div>
                </details>
                </div>
                <noscript><button type="submit">{{ 'products.facets.apply' | t }}</button></noscript>
              </form>
            </facet-filters-form>
          {%- endif -%}

          <div class="lemoon-plp-view-toggle">
            <button type="button" class="lemoon-plp-view-toggle__button" data-grid-toggle data-label-one="{{ 'lemoon.collection.one_column' | t | escape }}" data-label-two="{{ 'lemoon.collection.two_columns' | t | escape }}" aria-label="{{ 'lemoon.collection.one_column' | t }}" aria-pressed="false">
              <svg class="lemoon-plp-view-toggle__single" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="8" rx="1"/><rect x="4" y="13" width="16" height="8" rx="1"/></svg>
              <svg class="lemoon-plp-view-toggle__double" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg>
            </button>
          </div>
        </div>

          <p class="lemoon-plp-mobile-results" data-mobile-results data-label="{{ 'lemoon.collection.showing_results' | t: count: '__COUNT__' | escape }}">{{ 'lemoon.collection.showing_results' | t: count: collection.products_count }}</p>
          <div class="product-grid-container" id="ProductGridContainer">
            {% render 'lemoon-active-filters', collection: collection, sort_by: current_sort %}
            {% render 'lemoon-plp-product-page', collection: collection, paginate: paginate, desktop_columns: desktop_columns, page_size: section.settings.products_per_page %}
          </div>

        {%- assign seo_copy = collection.metafields.custom.plp_seo_copy -%}
        {%- if seo_copy.value != blank -%}
          <section class="lemoon-plp-seo rte" aria-label="{{ 'lemoon.collection.seo_description' | t }}">
            {{ seo_copy | metafield_tag }}
          </section>
        {%- elsif section.settings.show_demo_content -%}
          <section class="lemoon-plp-seo rte" aria-label="{{ 'lemoon.collection.seo_description' | t }}">
            {% render 'lemoon-collection-copy', collection: collection, mode: 'seo' %}
          </section>
        {%- endif -%}
          </div>
        </div>
      </div>
    {%- endpaginate -%}
    {% if section.settings.image_shape == 'arch' %}{{ 'mask-arch.svg' | inline_asset_content }}{%- endif -%}
  </div>
  {%- paginate collection.products by section.settings.products_per_page_mobile -%}
    <template data-plp-mobile-grid>
      {% render 'lemoon-plp-product-page', collection: collection, paginate: paginate, desktop_columns: desktop_columns, page_size: section.settings.products_per_page_mobile %}
    </template>
  {%- endpaginate -%}
</collection-component>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
    {"type": "checkbox", "id": "show_collection_description", "default": true, "label": "Mostrar descripción de la colección"},
    {"type": "checkbox", "id": "show_demo_content", "default": false, "label": "t:lemoon.collection.demo_content"},
    {
      "type": "range",
      "id": "products_per_page",
      "min": 5,
      "max": 50,
      "step": 5,
      "default": 15,
      "label": "Productos por página — desktop y tablet"
    },
    {
      "type": "range",
      "id": "products_per_page_mobile",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 16,
      "label": "Productos por página — mobile"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.image_shape.options__1.label"
        },
        {
          "value": "arch",
          "label": "t:sections.all.image_shape.options__2.label"
        },
        {
          "value": "blob",
          "label": "t:sections.all.image_shape.options__3.label"
        },
        {
          "value": "chevronleft",
          "label": "t:sections.all.image_shape.options__4.label"
        },
        {
          "value": "chevronright",
          "label": "t:sections.all.image_shape.options__5.label"
        },
        {
          "value": "diamond",
          "label": "t:sections.all.image_shape.options__6.label"
        },
        {
          "value": "parallelogram",
          "label": "t:sections.all.image_shape.options__7.label"
        },
        {
          "value": "round",
          "label": "t:sections.all.image_shape.options__8.label"
        }
      ],
      "default": "default",
      "label": "t:sections.all.image_shape.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_rating.label",
      "info": "t:sections.main-collection-product-grid.settings.show_rating.info"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
