<div class="lemoon-mood-grid page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="lemoon-mood-grid__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if section.settings.description != blank -%}
    <p class="lemoon-mood-grid__description">{{ section.settings.description | escape }}</p>
  {%- endif -%}
  <div class="lemoon-mood-grid__items">
    {%- for block in section.blocks -%}
      {%- liquid
        case forloop.index
          when 1
            assign fallback_image = 'lemoon-style-minimalista.png'
          when 2
            assign fallback_image = 'lemoon-style-sol.png'
          when 3
            assign fallback_image = 'lemoon-category-accessories.png'
        endcase
      -%}
      <a class="lemoon-mood-grid__item" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 600, 800, 1000', sizes: '(min-width: 750px) 32vw, 100vw', alt: block.settings.heading }}
        {%- else -%}
          <img
            src="{{ fallback_image | asset_url }}"
            alt="{{ block.settings.heading | escape }}"
            width="1024"
            height="1280"
            loading="lazy"
          >
        {%- endif -%}
        <span>{{ block.settings.heading | escape }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Categorías Lemoon",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Compra por categoría" },
    { "type": "text", "id": "description", "label": "Descripción" }
  ],
  "blocks": [
    {
      "type": "mood",
      "name": "Categoría",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "heading", "label": "Nombre", "default": "Lentes ópticos" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Categorías Lemoon", "blocks": [{ "type": "mood" }, { "type": "mood", "settings": { "heading": "Lentes de sol" } }, { "type": "mood", "settings": { "heading": "Accesorios" } }] }]
}
{% endschema %}
