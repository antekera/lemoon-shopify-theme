<div class="lemoon-mood-grid page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="lemoon-mood-grid__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="lemoon-mood-grid__items">
    {%- for block in section.blocks -%}
      {%- liquid
        case forloop.index
          when 1
            assign fallback_image = 'lemoon-style-minimalista.png'
          when 2
            assign fallback_image = 'lemoon-style-ejecutivo.png'
          when 3
            assign fallback_image = 'lemoon-style-retro.png'
          when 4
            assign fallback_image = 'lemoon-style-casual.png'
          else
            assign fallback_image = 'lemoon-style-sol.png'
        endcase
      -%}
      <a class="lemoon-mood-grid__item" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '224, 360, 448, 600', sizes: '(min-width: 990px) 18vw, 44vw', alt: block.settings.heading }}
        {%- else -%}
          <img
            src="{{ fallback_image | asset_url }}"
            alt="{{ block.settings.heading | escape }}"
            width="1024"
            height="1280"
            loading="lazy"
          >
        {%- endif -%}
        <span>{{ block.settings.heading | escape }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Estilos Lemoon",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Elige según tu estilo" }
  ],
  "blocks": [
    {
      "type": "mood",
      "name": "Estilo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "heading", "label": "Nombre", "default": "Minimalista" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Estilos Lemoon", "blocks": [{ "type": "mood" }, { "type": "mood", "settings": { "heading": "Ejecutivo" } }, { "type": "mood", "settings": { "heading": "Retro" } }, { "type": "mood", "settings": { "heading": "Casual" } }, { "type": "mood", "settings": { "heading": "Sol" } }] }]
}
{% endschema %}
