<div class="lemoon-how-it-works">
  <div class="lemoon-how-it-works__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="lemoon-how-it-works__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="lemoon-how-it-works__steps">
      {%- for block in section.blocks -%}
        <article class="lemoon-how-it-works__step" {{ block.shopify_attributes }}>
          <span class="lemoon-how-it-works__number" aria-hidden="true">0{{ forloop.index }}</span>
          <h3>{{ block.settings.heading | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cómo funciona",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Lentes simples, desde el primer clic."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Elige tu armazón"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descripción",
          "default": "Encuentra una forma y un color que se sientan naturalmente tuyos."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Cómo funciona",
      "blocks": [
        { "type": "step" },
        {
          "type": "step",
          "settings": {
            "heading": "Configura tus lentes",
            "text": "Agrega cristales para tu receta y para la forma en que ves el mundo."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Recíbelos en casa",
            "text": "Despachamos a todo Chile para que tu nueva mirada llegue sin vueltas."
          }
        }
      ]
    }
  ]
}
{% endschema %}
