{{ 'lemoon-pdp-layout.css' | asset_url | stylesheet_tag }}
<div class="lemoon-trust-bar" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="lemoon-trust-bar__inner page-width">{% render 'lemoon-shared-benefits' %}</div>
</div>
{% schema %}
{
  "name": "t:sections.lemoon_trust_bar.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "t:sections.lemoon_trust_bar.settings.aria_label.label",
      "default": "t:sections.lemoon_trust_bar.settings.aria_label.default"
    },
    {
      "type": "paragraph",
      "content": "t:sections.lemoon_trust_bar.settings.benefits.content"
    }
  ],
  "presets": [
    {
      "name": "t:sections.lemoon_trust_bar.name"
    }
  ]
}
{% endschema %}
