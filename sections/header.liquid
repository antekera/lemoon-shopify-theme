{{ 'lemoon-header.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- liquid
  assign header_logo = section.settings.logo | default: settings.logo
  assign show_account = shop.customer_accounts_enabled
-%}

<sticky-header
  data-sticky-type="on-scroll-up"
  class="lemoon-header-wrapper"
  style="
    --lemoon-header-background: #FFFFFF;
    --lemoon-header-text: #0B1F3A;
    --lemoon-header-accent: #F7E600;
    --lemoon-header-border: #E0DDD8;
    --lemoon-header-height: 72px;
    --lemoon-header-mobile-height: 56px;
    --lemoon-header-padding: 40px;
    --lemoon-header-nav-gap: 32px;
    --lemoon-header-nav-size: 15px;
    --lemoon-header-max-width: 1440px;
  "
>
  <header class="lemoon-header" role="banner">
    <div class="lemoon-header__desktop">
      <a class="lemoon-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if header_logo != blank -%}
          {%- assign logo_alt = header_logo.alt | default: shop.name | escape -%}
          {{
            header_logo
            | image_url: width: 600
            | image_tag:
              class: 'lemoon-header__logo-image',
              widths: '100, 150, 200, 300, 400, 600',
              width: 100,
              alt: logo_alt,
              preload: true
          }}
        {%- else -%}
          <span class="lemoon-header__wordmark" aria-label="{{ shop.name | escape }}">
            <span>lemo</span><span class="lemoon-header__wordmark-accent">o</span><span>n</span>
          </span>
        {%- endif -%}
      </a>

      <nav class="lemoon-header__navigation" aria-label="Navegación principal">
        {%- for link in section.settings.menu.links -%}
          <div class="lemoon-header__menu-item">
            {%- if link.links != blank -%}
              <details class="lemoon-header__menu-disclosure">
                <summary class="lemoon-header__menu-summary{% if link.current or link.child_active %} is-current{% endif %}">
                  {{ link.title | escape }}
                  {% render 'lemoon-icon', icon: 'chevron-down', size: 14 %}
                </summary>
                <ul class="lemoon-header__submenu" role="list">
                  <li><a class="lemoon-header__submenu-link" href="{{ link.url }}">Ver todo {{ link.title | escape }}</a></li>
                  {%- for childlink in link.links -%}
                    <li>
                      <a class="lemoon-header__submenu-link" href="{{ childlink.url }}"{% if childlink.current %} aria-current="page"{% endif %}>
                        {{ childlink.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a class="lemoon-header__nav-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                {{ link.title | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </nav>

      <div class="lemoon-header__actions">
        {%- if section.settings.whatsapp_url != blank -%}
          <a class="lemoon-header__whatsapp" href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener">
            {% render 'lemoon-icon', icon: 'message-circle', size: 16 %}
            <span>WhatsApp</span>
          </a>
        {%- endif -%}
        {% render 'header-search', input_id: 'Lemoon-Header-Search-Desktop' %}
        {%- if show_account -%}
          <a class="lemoon-header__action" href="{{ routes.account_url }}" aria-label="Cuenta">
            {% render 'lemoon-icon', icon: 'user', size: 24 %}
          </a>
        {%- endif -%}
        <a class="lemoon-header__cart" href="{{ routes.cart_url }}" id="cart-icon-bubble" aria-label="{{ 'templates.cart.cart' | t }}">
          {% render 'lemoon-icon', icon: 'shopping-bag', size: 24 %}
          {%- if cart.item_count > 0 -%}
            <span class="lemoon-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          {%- endif -%}
        </a>
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="lemoon-header__mobile">
      <div class="lemoon-header__mobile-inner">
        <div class="lemoon-header__mobile-drawer">
          {%- if section.settings.menu != blank -%}
            {% render 'header-drawer', show_country_selector: false, show_language_selector: false, show_social_links: false %}
          {%- endif -%}
        </div>
        <a class="lemoon-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {%- if header_logo != blank -%}
            {{
              header_logo
              | image_url: width: 400
              | image_tag:
                class: 'lemoon-header__logo-image',
                widths: '100, 150, 200, 300, 400',
              width: 100,
                alt: logo_alt
            }}
          {%- else -%}
            <span class="lemoon-header__wordmark" aria-label="{{ shop.name | escape }}">
              <span>lemo</span><span class="lemoon-header__wordmark-accent">o</span><span>n</span>
            </span>
          {%- endif -%}
        </a>
        <div class="lemoon-header__mobile-actions">
          {% render 'header-search', input_id: 'Lemoon-Header-Search-Mobile' %}
          <a class="lemoon-header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'templates.cart.cart' | t }}">
            {% render 'lemoon-icon', icon: 'shopping-bag', size: 24 %}
            {%- if cart.item_count > 0 -%}
              <span class="lemoon-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
              <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
            {%- endif -%}
          </a>
        </div>
      </div>
    </div>
  </header>
</sticky-header>

{% javascript %}
  if (!customElements.get('sticky-header')) {
    class StickyHeader extends HTMLElement {
      connectedCallback() {
        this.section = this.closest('.section-header');
        this.stickyType = this.dataset.stickyType;
        this.currentScrollTop = window.scrollY;
        this.setHeaderHeight = this.setHeaderHeight.bind(this);
        this.onScroll = this.onScroll.bind(this);
        this.setHeaderHeight();
        window.addEventListener('resize', this.setHeaderHeight);
        if (this.stickyType === 'always') {
          this.section.classList.add('shopify-section-header-sticky');
          return;
        }
        window.addEventListener('scroll', this.onScroll, { passive: true });
      }
      disconnectedCallback() {
        window.removeEventListener('resize', this.setHeaderHeight);
        window.removeEventListener('scroll', this.onScroll);
      }
      setHeaderHeight() {
        document.documentElement.style.setProperty('--header-height', String(this.offsetHeight) + 'px');
      }
      onScroll() {
        const nextScrollTop = window.scrollY;
        if (nextScrollTop <= 0) {
          this.section.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
        } else if (nextScrollTop > this.currentScrollTop) {
          this.section.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
        } else {
          this.section.classList.add('shopify-section-header-sticky', 'animate');
          this.section.classList.remove('shopify-section-header-hidden');
        }
        this.currentScrollTop = nextScrollTop;
      }
    }
    customElements.define('sticky-header', StickyHeader);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Lemoon header",
  "class": "section-header",
  "max_blocks": 3,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Si queda vacío, se utiliza el logo global o el wordmark Lemoon." },
    { "type": "link_list", "id": "menu", "label": "Menú principal", "default": "main-menu" },
    { "type": "url", "id": "whatsapp_url", "label": "Enlace de WhatsApp", "info": "Déjalo vacío para ocultarlo." }
  ],
  "blocks": [
    { "type": "@app" }
  ]
}
{% endschema %}
