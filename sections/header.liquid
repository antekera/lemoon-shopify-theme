{{ 'lemoon-header.css' | asset_url | stylesheet_tag }}
{{ 'lemoon-mobile-search.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<sticky-header
  data-sticky-type="always"
  class="lemoon-header-wrapper"
  style="
    --lemoon-header-background: #FFFFFF;
    --lemoon-header-text: #0B1F3A;
    --lemoon-header-accent: #F7E600;
    --lemoon-header-border: #E0DDD8;
    --lemoon-header-height: 88px;
    --lemoon-header-mobile-height: 56px;
    --lemoon-header-padding: 40px;
    --lemoon-header-nav-size: 15px;
    --lemoon-header-max-width: 1280px;
  "
>
  <header class="lemoon-header" role="banner" data-lemoon-search-header>
    <div class="lemoon-header__desktop">
      <div class="lemoon-header__leading-actions">
        <button class="lemoon-header__menu-btn" id="lemoon-nav-open-desktop" data-lemoon-nav-open aria-label="{{ 'sections.header.menu' | t }}">
          {% render 'lemoon-icon', icon: 'menu', size: 24 %}
        </button>
        {% render 'header-search', input_id: 'Lemoon-Header-Search-Desktop' %}
      </div>
      <a class="lemoon-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        <img
          src="{{ 'lemoon-logo-refined-navy.svg' | asset_url }}"
          alt="{{ shop.name | escape }}"
          class="lemoon-header__logo-image"
          width="120"
          height="28"
          loading="eager"
        >
      </a>

      <div class="lemoon-header__actions">
        <a class="lemoon-header__cart" href="{{ routes.cart_url }}" id="cart-icon-bubble" aria-label="{{ 'templates.cart.cart' | t }}">
          {% render 'lemoon-icon', icon: 'shopping-cart', size: 24 %}
          {%- if cart.item_count > 0 -%}
            <span class="lemoon-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          {%- endif -%}
        </a>
        <a class="lemoon-header__action" href="{{ routes.account_url }}" aria-label="{{ 'customer.account.title' | t }}">
          {% render 'lemoon-icon', icon: 'user-round', size: 24 %}
        </a>
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="lemoon-header__mobile">
      <div class="lemoon-header__mobile-inner">
        <div class="lemoon-header__mobile-drawer">
          <button class="lemoon-header__mobile-menu-btn" id="lemoon-nav-open" data-lemoon-nav-open aria-label="{{ 'sections.header.menu' | t }}">
            {% render 'lemoon-icon', icon: 'menu', size: 24 %}
          </button>
          <button type="button" class="lemoon-search-open" data-lemoon-search-open aria-label="{{ 'sections.mobile_search.open' | t }}" aria-controls="Lemoon-Mobile-Search-{{ section.id }}" aria-expanded="false" aria-haspopup="dialog">
            {% render 'lemoon-icon', icon: 'search', size: 24 %}
          </button>
        </div>
        <a class="lemoon-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          <img
            src="{{ 'lemoon-logo-refined-navy.svg' | asset_url }}"
            alt="{{ shop.name | escape }}"
            class="lemoon-header__logo-image"
            width="120"
            height="28"
            loading="eager"
          >
        </a>
        <div class="lemoon-header__mobile-actions">
          <a class="lemoon-header__cart" href="{{ routes.cart_url }}" id="cart-icon-bubble-mobile" aria-label="{{ 'templates.cart.cart' | t }}">
            {% render 'lemoon-icon', icon: 'shopping-cart', size: 24 %}
            {%- if cart.item_count > 0 -%}
              <span class="lemoon-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
              <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
            {%- endif -%}
          </a>
          <a class="lemoon-header__action" href="{{ routes.account_url }}" aria-label="{{ 'customer.account.title' | t }}">
            {% render 'lemoon-icon', icon: 'user-round', size: 24 %}
          </a>
        </div>
      </div>
    </div>

    {%- if section.settings.menu != blank -%}
      <nav class="lemoon-header__quick-nav" aria-label="{{ 'sections.header.quick_categories' | t }}">
        {%- for link in section.settings.menu.links limit: 4 -%}
          <a class="lemoon-header__quick-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
            {{ link.title | escape }}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </header>
  {% render 'lemoon-mobile-nav' %}
  {% render 'lemoon-mobile-search', section: section %}
</sticky-header>

{% javascript %}
  if (!customElements.get('sticky-header')) {
    class StickyHeader extends HTMLElement {
      connectedCallback() {
        this.section = this.closest('.section-header');
        this.stickyType = this.dataset.stickyType;
        this.currentScrollTop = window.scrollY;
        this.setHeaderHeight = this.setHeaderHeight.bind(this);
        this.onScroll = this.onScroll.bind(this);
        this.setHeaderHeight();
        window.addEventListener('resize', this.setHeaderHeight);
        if (this.stickyType === 'always') {
          this.section.classList.add('shopify-section-header-sticky');
          return;
        }
        window.addEventListener('scroll', this.onScroll, { passive: true });
      }
      disconnectedCallback() {
        window.removeEventListener('resize', this.setHeaderHeight);
        window.removeEventListener('scroll', this.onScroll);
      }
      setHeaderHeight() {
        document.documentElement.style.setProperty('--header-height', String(this.offsetHeight) + 'px');
      }
      onScroll() {
        const nextScrollTop = window.scrollY;
        if (nextScrollTop <= 0) {
          this.section.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
        } else if (nextScrollTop > this.currentScrollTop) {
          this.section.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
        } else {
          this.section.classList.add('shopify-section-header-sticky', 'animate');
          this.section.classList.remove('shopify-section-header-hidden');
        }
        this.currentScrollTop = nextScrollTop;
      }
    }
    customElements.define('sticky-header', StickyHeader);
  }

  // Sync mobile cart count with desktop, and delegate drawer clicks
  const desktopCart = document.getElementById('cart-icon-bubble');
  const mobileCart = document.getElementById('cart-icon-bubble-mobile');
  if (desktopCart && mobileCart) {
    mobileCart.addEventListener('click', (e) => {
      if (window.getComputedStyle(desktopCart).display === 'none') {
        e.preventDefault();
        desktopCart.click();
      }
    });
    new MutationObserver(() => {
      const badge = desktopCart.querySelector('.lemoon-header__cart-count');
      const mobileBadge = mobileCart.querySelector('.lemoon-header__cart-count');
      if (badge) {
        if (mobileBadge) mobileBadge.textContent = badge.textContent;
      } else if (mobileBadge) {
        mobileBadge.remove();
      }
    }).observe(desktopCart, { childList: true, subtree: true });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Lemoon header",
  "class": "section-header",
  "max_blocks": 3,
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menú principal", "info": "Se muestran hasta cuatro enlaces destacados en desktop y mobile.", "default": "main-menu" },
    { "type": "header", "content": "Búsqueda móvil: información" },
    { "type": "page", "id": "mobile_search_shipping_page", "label": "Envíos y retornos" },
    { "type": "url", "id": "mobile_search_faq_page", "label": "Preguntas frecuentes" },
    { "type": "url", "id": "mobile_search_style_page", "label": "Buscar mi estilo" },
    { "type": "header", "content": "Búsqueda móvil: tendencias" },
    { "type": "image_picker", "id": "mobile_search_banner_image", "label": "Imagen del banner" },
    { "type": "url", "id": "mobile_search_banner_url", "label": "Enlace del banner" },
    { "type": "product_list", "id": "mobile_search_trending_products", "label": "Productos de tendencias", "limit": 4 }
  ],
  "blocks": [
    { "type": "@app" }
  ]
}
{% endschema %}
