<div class="lemoon-hero">
  <div class="lemoon-hero__content page-width">
    <div class="lemoon-hero__copy">
      <h1>{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
      <div class="lemoon-hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a class="button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
            {{- section.settings.primary_label | escape -}}
            <span aria-hidden="true">→</span>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="button button--secondary" href="{{ section.settings.secondary_link | default: routes.root_url }}">
            {{- section.settings.secondary_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
    <div class="lemoon-hero__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1440
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '375, 550, 750, 900, 1200, 1440',
            sizes: '(min-width: 990px) 50vw, 100vw',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        <img
          src="{{ 'lemoon-hero-editorial.png' | asset_url }}"
          alt="Persona usando lentes Lemoon"
          width="1024"
          height="1280"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Lemoon",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen editorial" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Lentes que te definen." },
    { "type": "text", "id": "text", "label": "Descripción", "default": "Armazones de calidad con envío a todo Chile." },
    { "type": "text", "id": "primary_label", "label": "CTA principal", "default": "Ver colección" },
    { "type": "url", "id": "primary_link", "label": "Enlace CTA principal" },
    { "type": "text", "id": "secondary_label", "label": "CTA secundario", "default": "Guía de estilo" },
    { "type": "url", "id": "secondary_link", "label": "Enlace CTA secundario" }
  ],
  "presets": [{ "name": "Hero Lemoon" }]
}
{% endschema %}
