{{ 'lemoon-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lemoon-hero.js' | asset_url }}" defer="defer"></script>

<lemoon-hero class="lemoon-hero" data-autoplay-seconds="{{ section.settings.autoplay_seconds }}" role="region" aria-roledescription="{{ 'sections.slideshow.carousel' | t }}" aria-label="{{ 'sections.lemoon_hero.label' | t }}">
  <div class="lemoon-hero__track" id="LemoonHero-{{ section.id }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign desktop_image = block.settings.desktop_image
        assign mobile_image = block.settings.mobile_image
        assign desktop_alt = desktop_image.alt | default: shop.name
        assign mobile_alt = mobile_image.alt | default: desktop_alt
        if forloop.first
          assign image_loading = 'eager'
          assign image_priority = 'high'
        else
          assign image_loading = 'lazy'
          assign image_priority = 'auto'
        endif
      -%}
      <div class="lemoon-hero__slide" id="LemoonHeroSlide-{{ block.id }}" role="group" aria-roledescription="{{ 'sections.slideshow.slide' | t }}" aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}" {{ block.shopify_attributes }}>
        <picture class="lemoon-hero__picture">
          {%- if mobile_image != blank -%}
            <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w, {{ mobile_image | image_url: width: 1500 }} 1500w" sizes="100vw">
          {%- elsif desktop_image == blank -%}
            <source media="(max-width: 749px)" srcset="{{ 'lemoon-hero-mobile-placeholder.jpg' | asset_url }}">
          {%- endif -%}
          {%- if desktop_image != blank -%}
            {{ desktop_image | image_url: width: 2400 | image_tag: class: 'lemoon-hero__image', loading: image_loading, fetchpriority: image_priority, widths: '750, 1100, 1500, 1800, 2400', sizes: '100vw', alt: desktop_alt }}
          {%- elsif mobile_image != blank -%}
            {{ mobile_image | image_url: width: 1500 | image_tag: class: 'lemoon-hero__image', loading: image_loading, fetchpriority: image_priority, widths: '750, 1100, 1500', sizes: '100vw', alt: mobile_alt }}
          {%- else -%}
            <img class="lemoon-hero__image" src="{{ 'lemoon-hero-desktop-placeholder.jpg' | asset_url }}" alt="{{ 'sections.lemoon_hero.placeholder_alt' | t | escape }}" width="1672" height="940" loading="{{ image_loading }}" fetchpriority="{{ image_priority }}">
          {%- endif -%}
        </picture>
        {%- if block.settings.button_1_text != blank or block.settings.button_2_text != blank -%}
          <div class="lemoon-hero__actions">
            {%- if block.settings.button_1_text != blank -%}
              <a class="lemoon-hero__button lemoon-hero__button--primary" href="{{ block.settings.button_1_link | default: routes.all_products_collection_url }}">{{ block.settings.button_1_text | escape }}</a>
            {%- endif -%}
            {%- if block.settings.button_2_text != blank -%}
              <a class="lemoon-hero__button lemoon-hero__button--secondary" href="{{ block.settings.button_2_link | default: routes.all_products_collection_url }}">{{ block.settings.button_2_text | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <div class="lemoon-hero__navigation">
      <button class="lemoon-hero__arrow" type="button" data-hero-previous aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}" aria-controls="LemoonHero-{{ section.id }}">‹</button>
      <div class="lemoon-hero__dots">
        {%- for block in section.blocks -%}
          <button class="lemoon-hero__dot{% if forloop.first %} is-active{% endif %}" type="button" data-hero-index="{{ forloop.index0 }}" aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}" aria-controls="LemoonHero-{{ section.id }}"{% if forloop.first %} aria-current="true"{% endif %}><span></span></button>
        {%- endfor -%}
      </div>
      <button class="lemoon-hero__arrow" type="button" data-hero-next aria-label="{{ 'sections.slideshow.next_slideshow' | t }}" aria-controls="LemoonHero-{{ section.id }}">›</button>
    </div>
  {%- endif -%}
</lemoon-hero>

{% schema %}
{
  "name": "Hero Lemoon",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 8,
  "settings": [
    { "type": "range", "id": "autoplay_seconds", "label": "Segundos entre slides", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 4 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "Imagen desktop" },
        { "type": "image_picker", "id": "mobile_image", "label": "Imagen mobile" },
        { "type": "text", "id": "button_1_text", "label": "Botón 1: texto", "default": "Ver todo hombre" },
        { "type": "url", "id": "button_1_link", "label": "Botón 1: enlace" },
        { "type": "text", "id": "button_2_text", "label": "Botón 2: texto", "default": "Ver todo mujer" },
        { "type": "url", "id": "button_2_link", "label": "Botón 2: enlace" }
      ]
    }
  ],
  "presets": [{ "name": "Hero Lemoon", "blocks": [{ "type": "slide" }] }]
}
{% endschema %}
