{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>

{%- style -%}
#shopify-section-{{ section.id }} .lemoon-search .template-search__header { margin-bottom: var(--lemoon-space-8); }
#shopify-section-{{ section.id }} .lemoon-search__title {
  margin: 0 0 var(--lemoon-space-8);
  color: var(--lemoon-text-brand);
  font-family: var(--lemoon-font-heading);
  font-size: 4rem;
  font-weight: var(--lemoon-weight-light);
  line-height: 1.2;
  letter-spacing: var(--lemoon-type-display-tracking);
}
#shopify-section-{{ section.id }} .lemoon-search .template-search__search { max-width: 92rem; margin: 0 0 var(--lemoon-space-8); }
#shopify-section-{{ section.id }} .lemoon-search .lemoon-search__form { display: flex; align-items: stretch; gap: var(--lemoon-space-4); margin: 0; }
#shopify-section-{{ section.id }} .lemoon-search .lemoon-search__field { flex: 1; min-width: 0; }
#shopify-section-{{ section.id }} .lemoon-search .lemoon-search__field::before,
#shopify-section-{{ section.id }} .lemoon-search .lemoon-search__field::after { content: none; }
#shopify-section-{{ section.id }} .lemoon-search .lemoon-search__field .field__input {
  height: 5.8rem;
  margin: 0;
  padding: var(--lemoon-space-4) 5.6rem var(--lemoon-space-4) var(--lemoon-space-6);
  border: 1px solid var(--lemoon-border-warm);
  border-radius: var(--lemoon-radius-search);
  background: var(--lemoon-surface-page);
  color: var(--lemoon-text-primary);
  box-shadow: none;
  font-size: 1.6rem;
  text-align: left;
}
#shopify-section-{{ section.id }} .lemoon-search .lemoon-search__field .field__input::placeholder { color: var(--lemoon-text-secondary); opacity: 1; }
#shopify-section-{{ section.id }} .lemoon-search .lemoon-search__field .reset__button { top: .7rem; right: .8rem; min-width: 4.4rem; min-height: 4.4rem; }
#shopify-section-{{ section.id }} .lemoon-search .lemoon-search__field .reset__button::after { content: none; }
#shopify-section-{{ section.id }} .lemoon-search__submit,
#shopify-section-{{ section.id }} .lemoon-search__catalogue {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  min-height: 5.8rem;
  padding: var(--lemoon-space-4) var(--lemoon-space-8);
  border: 1px solid var(--lemoon-action-primary);
  border-radius: var(--lemoon-radius-button);
  background: var(--lemoon-action-primary);
  color: var(--lemoon-text-inverse);
  font-family: var(--lemoon-font-heading);
  font-size: 1.4rem;
  font-weight: var(--lemoon-weight-semibold);
  line-height: 1.4;
  text-decoration: none;
  cursor: pointer;
}
#shopify-section-{{ section.id }} .lemoon-search__submit:hover,
#shopify-section-{{ section.id }} .lemoon-search__catalogue:hover { border-color: var(--lemoon-action-primary-hover); background: var(--lemoon-action-primary-hover); }
#shopify-section-{{ section.id }} .lemoon-search :is(input, button, a):focus-visible { outline: 2px solid var(--lemoon-border-strong); outline-offset: 4px; }
#shopify-section-{{ section.id }} .lemoon-search__count { margin: 0; color: var(--lemoon-text-secondary); font-size: 1.4rem; }
#shopify-section-{{ section.id }} .lemoon-search .facets-wrapper { margin-bottom: var(--lemoon-space-6); }
#shopify-section-{{ section.id }} .lemoon-search .facets-container { border-top: 1px solid var(--lemoon-border-default); padding-top: var(--lemoon-space-5); }
#shopify-section-{{ section.id }} .lemoon-search .product-grid { margin-top: 0; row-gap: var(--lemoon-grid-gap-desktop); }
#shopify-section-{{ section.id }} .lemoon-search .collection--empty .title-wrapper { margin: var(--lemoon-space-10) 0; }
#shopify-section-{{ section.id }} .lemoon-search .collection--empty .title { font-size: var(--lemoon-type-h3-size); font-weight: var(--lemoon-weight-medium); }
#shopify-section-{{ section.id }} .lemoon-search__recovery {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--lemoon-space-8);
  margin-top: var(--lemoon-space-12);
  padding: var(--lemoon-space-10);
  border-radius: var(--lemoon-radius-modal);
  background: var(--lemoon-surface-warm);
}
#shopify-section-{{ section.id }} .lemoon-search__recovery h2 {
  margin: 0 0 var(--lemoon-space-4);
  color: var(--lemoon-text-brand);
  font-family: var(--lemoon-font-heading);
  font-size: 2.4rem;
  font-weight: var(--lemoon-weight-medium);
  line-height: 1.3;
}
#shopify-section-{{ section.id }} .lemoon-search__recovery ul { margin: 0; padding-left: var(--lemoon-space-5); color: var(--lemoon-text-secondary); font-size: 1.4rem; line-height: 1.7; }
#shopify-section-{{ section.id }} .lemoon-search__catalogue { flex-shrink: 0; min-height: 4.8rem; padding: var(--lemoon-space-3) var(--lemoon-space-6); }
@media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} .lemoon-search__title { margin-bottom: var(--lemoon-space-6); font-size: 3.4rem; }
  #shopify-section-{{ section.id }} .lemoon-search .lemoon-search__form { gap: var(--lemoon-space-2); }
  #shopify-section-{{ section.id }} .lemoon-search .lemoon-search__field .field__input { height: 5.4rem; padding-left: var(--lemoon-space-4); }
  #shopify-section-{{ section.id }} .lemoon-search .lemoon-search__field .reset__button { top: .5rem; }
  #shopify-section-{{ section.id }} .lemoon-search__submit { min-height: 5.4rem; padding: var(--lemoon-space-3) var(--lemoon-space-4); }
  #shopify-section-{{ section.id }} .lemoon-search .product-grid { row-gap: var(--lemoon-grid-gap-mobile); }
  #shopify-section-{{ section.id }} .lemoon-search__recovery { flex-direction: column; align-items: stretch; margin-top: var(--lemoon-space-8); padding: var(--lemoon-space-6); gap: var(--lemoon-space-6); }
  #shopify-section-{{ section.id }} .lemoon-search__recovery h2 { font-size: 2.2rem; }
  #shopify-section-{{ section.id }} .lemoon-search__catalogue { width: 100%; }
}
{%- endstyle -%}

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | url_encode
  assign search_url = '?q=' | append: terms | append: '&type=product&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  assign show_all_products = false
  assign has_results = false

  if search.terms == blank
    assign show_all_products = true
    if collections.all.products_count > 0
      assign has_results = true
    endif
  elsif search.performed and search.results_count > 0
    assign has_results = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% if show_all_products %}
  {% paginate collections.all.products by 24 %}
    {% render 'main-search-results',
      section: section,
      paginate: paginate,
      show_all_products: show_all_products,
      has_results: has_results,
      search_url: search_url
    %}
  {% endpaginate %}
{% else %}
  {% paginate search.results by 24 %}
    {% render 'main-search-results',
      section: section,
      paginate: paginate,
      show_all_products: show_all_products,
      has_results: has_results,
      search_url: search_url
    %}
  {% endpaginate %}
{% endif %}
{% if section.settings.image_shape == 'arch' %}
  {{ 'mask-arch.svg' | inline_asset_content }}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.main-search.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "1",
      "label": "t:sections.main-search.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-search.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-search.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-search.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-search.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-search.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-search.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.image_shape.options__1.label"
        },
        {
          "value": "arch",
          "label": "t:sections.all.image_shape.options__2.label"
        },
        {
          "value": "blob",
          "label": "t:sections.all.image_shape.options__3.label"
        },
        {
          "value": "chevronleft",
          "label": "t:sections.all.image_shape.options__4.label"
        },
        {
          "value": "chevronright",
          "label": "t:sections.all.image_shape.options__5.label"
        },
        {
          "value": "diamond",
          "label": "t:sections.all.image_shape.options__6.label"
        },
        {
          "value": "parallelogram",
          "label": "t:sections.all.image_shape.options__7.label"
        },
        {
          "value": "round",
          "label": "t:sections.all.image_shape.options__8.label"
        }
      ],
      "default": "default",
      "label": "t:sections.all.image_shape.label"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.main-search.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.main-search.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.main-search.settings.show_rating.label",
      "info": "t:sections.main-search.settings.show_rating.info"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        {
          "value": "horizontal",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__1.label"
        },
        {
          "value": "vertical",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__2.label"
        },
        {
          "value": "drawer",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__3.label"
        }
      ],
      "default": "horizontal",
      "label": "t:sections.main-collection-product-grid.settings.filter_type.label"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__2.content"
    },
    {
      "type": "checkbox",
      "id": "article_show_date",
      "default": true,
      "label": "t:sections.main-search.settings.article_show_date.label"
    },
    {
      "type": "checkbox",
      "id": "article_show_author",
      "default": false,
      "label": "t:sections.main-search.settings.article_show_author.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "presets": [
    {
      "name": "t:sections.main-search.name"
    }
  ]
}
{% endschema %}
