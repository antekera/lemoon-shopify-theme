{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0b1f3a">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {%- assign formatted_balance = gift_card.balance | money_without_trailing_zeros | strip_html -%}
    <title>{{ 'gift_cards.issued.title' | t: value: formatted_balance, shop: shop.name | escape }}</title>
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t | escape }}">
    {{ content_for_header }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Urbanist:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    {{ 'lemoon-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'template-giftcard.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script src="{{ 'lemoon-gift-card.js' | asset_url }}" defer></script>
  </head>
  <body class="gift-card"
    data-copy-success="{{ 'gift_cards.issued.copy_code_success' | t | escape }}"
    data-copy-error="{{ 'gift_cards.lemoon.copy_error' | t | escape }}"
  >
    <header class="gift-card__header">
      <a href="{{ shop.url }}" class="gift-card__brand" aria-label="{{ shop.name | escape }}">
        <img src="{{ 'lemoon-logo-refined-navy.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="160" height="40" loading="eager">
      </a>
    </header>
    <main class="gift-card__main">
      <h1>{{ 'gift_cards.lemoon.heading' | t }}</h1>
      <div class="gift-card__panel">
        <div class="gift-card__balance">
          <p class="gift-card__label">{{ 'gift_cards.lemoon.balance' | t }}</p>
          <p class="gift-card__price">
            {% if settings.currency_code_enabled %}
              {{ gift_card.balance | money_with_currency }}
            {% else %}
              {{ gift_card.balance | money }}
            {% endif %}
          </p>
          {%- if gift_card.enabled == false -%}
            <p class="gift-card__state">{{ 'gift_cards.lemoon.disabled' | t }}</p>
          {%- elsif gift_card.expired -%}
            <p class="gift-card__state">{{ 'gift_cards.issued.expired' | t }}</p>
          {%- elsif gift_card.balance == 0 -%}
            <p class="gift-card__state">{{ 'gift_cards.lemoon.empty' | t }}</p>
          {%- endif -%}
          {% if gift_card.expires_on %}
            {%- assign gift_card_expiration_date = gift_card.expires_on | date: '%d/%m/%Y' -%}
            <p class="gift-card__expiry">{{ 'gift_cards.issued.expiration_date' | t: expires_on: gift_card_expiration_date }}</p>
          {% endif %}
        </div>
        <div class="gift-card__details">
          <p id="gift-card-code-label" class="gift-card__label">{{ 'gift_cards.lemoon.code_label' | t }}</p>
          <p id="gift-card-code" class="gift-card__number" aria-labelledby="gift-card-code-label">{{ gift_card.code | format_code | escape }}</p>
          <p class="gift-card__instructions">{{ 'gift_cards.lemoon.instructions' | t }}</p>
          <button type="button" class="gift-card__button gift-card__copy-button no-print" hidden>
            <span class="gift-card__icon" aria-hidden="true">{{ 'icon-copy.svg' | inline_asset_content }}</span>
            {{ 'gift_cards.issued.copy_code' | t }}
          </button>
          <p class="gift-card__copy-success no-print" role="status" aria-live="polite" aria-atomic="true"></p>
          {%- if gift_card.qr_identifier != blank -%}
            <div class="gift-card__qr-code" data-identifier="{{ gift_card.qr_identifier | escape }}" data-alt="{{ 'gift_cards.issued.qr_image_alt' | t | escape }}"></div>
          {%- endif -%}
          {%- if gift_card.pass_url -%}
            <a href="{{ gift_card.pass_url | escape }}" class="gift-card__apple-wallet no-print">
              <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t | escape }}" loading="lazy">
            </a>
          {%- endif -%}
        </div>
      </div>
      <div class="gift-card__actions no-print">
        <a href="{{ shop.url }}" class="gift-card__button gift-card__button--primary">{{ 'gift_cards.issued.shop_link' | t }}</a>
        <button type="button" class="gift-card__print-button" hidden>{{ 'gift_cards.lemoon.print' | t }}</button>
      </div>
    </main>
  </body>
</html>
