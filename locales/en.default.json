    "lemoon_faq_page": {
      "title": "Frequently asked questions.",
      "intro": "Answers to help you choose your frame, review its options and buy with clear details.",
      "index": "Browse by topic",
      "help_title": "Still have a question?",
      "help_body": "Tell us which model you are considering or where you need help.",
      "contact": "Get in touch",
      "choosing": {
        "title": "Choosing your frame",
        "question_1": {
          "question": "How do I choose a size?",
          "answer": "Compare the product dimensions with a frame you already find comfortable. Distinguish lens width, bridge and temple length; lens width is not overall frame width. Shape and bridge support also affect fit.",
          "link": "Read the measurement guide"
        },
        "question_2": {
          "question": "Why does the price change when I select options?",
          "answer": "Colour and available options may select a different variant. Review the price shown after choosing and check the variant and subtotal in your cart. You are charged for the options of the variant you add.",
          "link": "See how to place your order"
        },
        "question_3": {
          "question": "Does every model offer virtual try-on?",
          "answer": "Try-on appears only when the model’s page has a configured link. If you do not see it, use its photos and dimensions as a reference. A digital visualisation helps explore style but does not confirm physical fit.",
          "link": "Read the try-on guide"
        }
      },
      "lenses": {
        "title": "Lenses and prescriptions",
        "question_1": {
          "question": "How do I enter my prescription?",
          "answer": "First check whether the model offers prescription lenses. Its page shows enabled options for manual entry or a document. Use only those fields, copy values without interpreting them and ask if a value is missing. Do not send health information through newsletter signup.",
          "link": "Read the prescription guide"
        },
        "question_2": {
          "question": "Can I buy just the frame?",
          "answer": "When the product page offers a frame-only purchase option, you can select it without completing a prescription. Check the colour, variant and availability before adding it to your cart. Options depend on each product.",
          "link": "Explore frames"
        }
      },
      "ordering": {
        "title": "Orders, account and help",
        "question_1": {
          "question": "What should I review before confirming my order?",
          "answer": "Check the product, variant, quantity and subtotal in your cart. Then review your contact information, address, available shipping options, payment methods and total at checkout. Confirm after checking the information and displayed conditions.",
          "link": "Follow the ordering guide"
        },
        "question_2": {
          "question": "Where do I access my account?",
          "answer": "An account is optional when shopping. Use the account access link to view orders and manage your profile and addresses. Shopify manages sign-in on its secure page. Sign in using the email associated with your purchase.",
          "link": "Access my account"
        },
        "question_3": {
          "question": "How do I ask for help with a product or order?",
          "answer": "Use our contact form and include the model or your order number, if you have one. Briefly explain what you need to review. Do not include passwords, payment details or prescription documents in that message.",
          "link": "Go to the contact form"
        }
      },
      "policies": {
        "title": "Shipping and conditions",
        "question_1": {
          "question": "Where can I check shipping conditions?",
          "answer": "Check the shipping page and the options shown at checkout for your address. Review charges and available information before confirming your purchase.",
          "link": "Review shipping and delivery"
        },
        "question_2": {
          "question": "Where can I find return conditions?",
          "answer": "Read the current returns policy before buying. If you need clarification for a product or order, ask the team before starting a request.",
          "link": "Review the returns policy"
        },
        "question_3": {
          "question": "Where can I check the warranty?",
          "answer": "Read the current warranty conditions for coverage and how to request assistance. If information about your case is missing, contact the team before assuming coverage.",
          "link": "Review warranty conditions"
        }
      }
    },
