{% doc %}
  Generic classic optical frame for educational measurement diagrams.
  @param {string} instance_id - Unique prefix for accessible SVG titles.
  @param {string} label - Localized description of both views; no product values.
{% enddoc %}
<figure class="lemoon-measurement-diagram">
  <div class="lemoon-measurement-diagram__views">
    <div class="lemoon-measurement-diagram__view">
      <svg viewBox="-12 -12 448 254" role="img" aria-labelledby="FrameFront-{{ instance_id | escape }}" focusable="false" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <title id="FrameFront-{{ instance_id | escape }}">{{ 'lemoon_size_guide.front_view' | t | escape }}</title>
        <path d="M49 74H151C168 74 177 84 177 94Q200 82 223 94C223 84 232 74 249 74H351C368 74 377 84 377 101V142C377 160 365 168 348 168H252C235 168 223 160 223 142V108Q200 96 177 108V142C177 160 165 168 148 168H52C35 168 23 160 23 142V101C23 84 32 74 49 74Z M51 84H149Q166 84 166 101V143Q166 158 149 158H51Q34 158 34 143V101Q34 84 51 84Z M251 84H349Q366 84 366 101V143Q366 158 349 158H251Q234 158 234 143V101Q234 84 251 84Z" fill="currentColor" fill-opacity=".07" fill-rule="evenodd" stroke-width="1.6"/>
        <path d="M17 88H23V103H17Z M377 88H383V103H377Z" fill="currentColor" fill-opacity=".07" stroke-width="1.3"/>
        <g stroke-width="1.1" stroke-opacity=".72">
          <path d="M17 40H383M17 34V46M383 34V46M34 194H166M34 188V200M166 188V200M166 124H234M166 118V130M234 118V130M405 84V158M399 84H411M399 158H411"/>
          <path d="M17 52V81M383 52V81M34 174V187M166 174V187M372 84H397M372 158H397" stroke-opacity=".35"/>
        </g>
        <g fill="currentColor" stroke="none" font-family="inherit" font-size="16" text-anchor="middle" aria-hidden="true">
          <text x="200" y="27">A</text><text x="100" y="219">B</text><text x="200" y="150">C</text><text x="388" y="129">D</text>
        </g>
      </svg>
      <p class="lemoon-measurement-diagram__view-name">{{ 'lemoon_size_guide.front_view' | t }}</p>
    </div>
    <div class="lemoon-measurement-diagram__view">
      <svg viewBox="-12 -18 424 200" role="img" aria-labelledby="FrameSide-{{ instance_id | escape }}" focusable="false" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <title id="FrameSide-{{ instance_id | escape }}">{{ 'lemoon_size_guide.side_view' | t | escape }}</title>
        <path d="M25 77L34 78L40 139L32 140Z" fill="currentColor" fill-opacity=".07" stroke-width="1.4"/>
        <path d="M34 78L257 64Q287 61 303 78C319 96 330 120 343 136Q347 143 342 146Q337 149 333 142C321 125 312 104 297 88Q285 77 263 79L36 91Z" fill="currentColor" fill-opacity=".07" stroke-width="1.5"/>
        <path d="M43 79V90" stroke-width="1"/>
        <g stroke-width="1.1" stroke-opacity=".72">
          <path d="M36 47L253 33Q295 28 316 53C337 78 349 101 366 122M31 42L41 52M360 126L372 118"/>
          <path d="M36 79V39M340 141L376 119" stroke-opacity=".35"/>
        </g>
        <text x="197" y="18" fill="currentColor" stroke="none" font-family="inherit" font-size="16" text-anchor="middle" aria-hidden="true">E</text>
      </svg>
      <p class="lemoon-measurement-diagram__view-name">{{ 'lemoon_size_guide.side_view' | t }}</p>
    </div>
  </div>
  <figcaption>{{ label | escape }}</figcaption>
</figure>
