        </defs>
        <path d="M25 74Q21 91 32 143L40 142Q34 113 35 78Z" fill="currentColor" fill-opacity=".3" stroke-width="1.4"/>
        <path d="M40 78C103 76 184 68 254 58C281 54 302 58 313 72C329 90 337 113 346 130C348 134 347 139 343 142C339 145 334 143 331 139C322 124 314 105 302 91C292 80 279 77 259 80L40 93Z" transform="translate(0 2)" fill="currentColor" fill-opacity=".2" stroke-opacity=".45" stroke-width="1"/>
        <path d="M40 78C103 76 184 68 254 58C281 54 302 58 313 72C329 90 337 113 346 130C348 134 347 139 343 142C339 145 334 143 331 139C322 124 314 105 302 91C292 80 279 77 259 80L40 93Z" fill="url(#FrameSideRim-{{ instance_id | escape }})" stroke-width="1.5"/>
        <path d="M44 80C117 77 189 69 255 61C281 57 298 61 308 73" style="stroke:var(--lemoon-surface-page)" stroke-opacity=".8" stroke-width="1.1"/>
        <path d="M49 89L258 76C279 73 295 77 306 91C319 108 326 126 337 139" stroke-opacity=".5" stroke-width="1.1"/>
        <path d="M33 79L43 78L44 93L35 95Z" fill="currentColor" fill-opacity=".36" stroke-width="1"/>
        <circle cx="48" cy="85" r="2.5" fill="currentColor" fill-opacity=".32" stroke-width=".9"/>
        <path d="M46.5 84L49.5 86" stroke-width=".8"/>
        <g stroke-width="1.1">
          <path d="M40 46C110 44 188 36 251 27C290 21 315 31 333 55C347 76 356 97 366 115M35 41L45 51M360 119L372 111"/>
          <path d="M40 80V38M340 139L376 113" stroke-opacity=".28"/>
        </g>
        <text x="197" y="18" fill="currentColor" stroke="none" font-family="inherit" font-size="16" text-anchor="middle" aria-hidden="true">E</text>
      </svg>
      <p class="lemoon-measurement-diagram__view-name">{{ 'lemoon_size_guide.side_view' | t }}</p>
    </div>
  </div>
  <figcaption>{{ label | escape }}</figcaption>
</figure>
