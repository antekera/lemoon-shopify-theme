{% doc %}
  Social links from theme settings. Omitted order preserves the standard storefront order.
  @param {string} [class] - Additional list classes.
  @param {string} [order] - Comma-separated supported network names in the owner's existing order.
{% enddoc %}
{%- liquid
  assign supported_networks = 'facebook,instagram,youtube,tiktok,twitter,pinterest,snapchat,tumblr,vimeo' | split: ','
  assign network_order = order | default: 'facebook,instagram,youtube,tiktok,twitter,pinterest,snapchat,tumblr,vimeo' | split: ','
-%}
<ul class="list-unstyled list-social{% if class %} {{ class | escape }}{% endif %}" role="list">
  {%- for network in network_order -%}
    {%- assign network = network | strip -%}
    {%- if supported_networks contains network -%}
      {%- liquid
        assign network_setting = 'social_' | append: network | append: '_link'
        assign network_url = settings[network_setting]
        assign network_icon = 'icon-' | append: network | append: '.svg'
        assign network_label = 'general.social.links.' | append: network
      -%}
      {%- if network_url != blank -%}
        <li class="list-social__item">
          <a href="{{ network_url | escape }}" class="link list-social__link">
            <span class="svg-wrapper">{{- network_icon | inline_asset_content -}}</span>
            <span class="visually-hidden">{{ network_label | t }}</span>
          </a>
        </li>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
</ul>
