      <path d="M105 138C108 135 112 136 114 138M119 159C124 157 130 158 135 160M132 176C139 179 146 179 152 177" stroke-opacity=".32"/>
      <path d="M146 94C171 92 201 93 224 94C234 94 241 91 247 97C253 103 254 117 249 130L245 139" stroke-width="2.8"/>
      <path d="M226 104C225 95 233 89 242 92C253 96 258 109 255 123C252 137 245 147 237 149C230 149 226 141 227 131" fill="url(#{{ fit_art_id }}-skin)"/>
      <path d="M234 104C235 96 243 98 246 106C248 115 242 123 237 129M234 112C239 108 243 113 239 118M235 135C240 131 243 136 238 141" stroke-opacity=".45"/>
