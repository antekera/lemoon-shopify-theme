      <ellipse cx="142" cy="126" rx="12" ry="23" fill="url(#{{ fit_art_id }}-shade)" stroke="none"/>
      <path d="M148 74C163 65 183 66 200 73C183 71 164 71 149 77Z M121 77C126 73 133 73 139 75L138 78C132 76 127 78 122 80Z" fill="currentColor" fill-opacity=".32" stroke="none"/>
      <path d="M151 95C163 86 180 87 193 96C180 104 164 104 151 95Z" fill="var(--lemoon-surface-page)" stroke-opacity=".7"/>
      <ellipse cx="170" cy="95" rx="5.1" ry="6.2" fill="currentColor" fill-opacity=".42" stroke-width=".8"/><circle cx="170" cy="95" r="2.4" fill="currentColor" stroke="none"/><circle cx="168" cy="93" r="1.2" fill="var(--lemoon-surface-page)" stroke="none"/>
      <path d="M128 95.5C131.2 91.3 138.6 91.9 142 95.9C138.7 99.7 131.6 99.1 128 95.5Z" fill="var(--lemoon-surface-page)" stroke-width=".9" stroke-opacity=".7"/>
