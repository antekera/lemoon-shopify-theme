      <path d="M156 202C177 210 196 199 215 183C238 164 255 139 264 112" stroke-opacity=".3"/>
      <ellipse cx="230" cy="147" rx="26" ry="45" fill="url(#{{ fit_art_id }}-shade)" stroke="none"/>
      <ellipse cx="150" cy="129" rx="21" ry="27" fill="url(#{{ fit_art_id }}-shade)" stroke="none"/>
      <path d="M120 79C128 74 138 75 146 80C137 78 128 79 121 82Z" fill="currentColor" fill-opacity=".32" stroke="none"/>
      <path d="M120 100C124 96 131 97 136 101C131 105 125 104 120 100Z" fill="var(--lemoon-surface-page)" stroke-opacity=".65"/>
