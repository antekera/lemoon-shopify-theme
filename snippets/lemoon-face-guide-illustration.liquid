{% doc %}
  Original decorative fit illustrations in the face portraits' ivory/navy family.
  HTML captions carry the complete advice; no scale or optical centring claims.
  @param {string} kind - bridge, cheek or temple.
  @param {string} instance_id - Parent section ID; gradients are unique by section/kind.
{% enddoc %}
{%- assign fit_art_id = instance_id | append: '-' | append: kind | handleize | prepend: 'FaceFitArt-' -%}
<svg viewBox="0 0 400 250" width="400" height="250" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="{{ fit_art_id }}-skin" cx="43%" cy="35%" r="70%">
      <stop stop-color="var(--lemoon-surface-page)"/>
      <stop offset=".58" stop-color="var(--lemoon-surface-warm)"/>
      <stop offset="1" stop-color="var(--lemoon-surface-warm-hover)"/>
    </radialGradient>
    <linearGradient id="{{ fit_art_id }}-neck" x1="0" y1="0" x2="1" y2="1">
      <stop stop-color="currentColor" stop-opacity=".13"/>
      <stop offset=".55" stop-color="var(--lemoon-surface-warm-hover)" stop-opacity=".5"/>
      <stop offset="1" stop-color="var(--lemoon-surface-warm)" stop-opacity="0"/>
    </linearGradient>
    <radialGradient id="{{ fit_art_id }}-shade">
      <stop stop-color="currentColor" stop-opacity=".13"/>
      <stop offset="1" stop-color="currentColor" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="{{ fit_art_id }}-soft" x1="0" y1="0" x2="0" y2="1">
      <stop stop-color="currentColor" stop-opacity=".18"/>
      <stop offset="1" stop-color="currentColor" stop-opacity="0"/>
    </linearGradient>
    {%- if kind == 'cheek' or kind == 'temple' -%}
      <linearGradient id="{{ fit_art_id }}-outline" gradientUnits="userSpaceOnUse" x1="0" y1="224" x2="0" y2="244">
        <stop stop-color="currentColor"/>
        <stop offset=".5" stop-color="currentColor"/>
        <stop offset="1" stop-color="currentColor" stop-opacity="0"/>
      </linearGradient>
    {%- endif -%}
  </defs>
  {%- case kind -%}
    {%- when 'bridge' -%}
      <!-- Frontal crop: the bridge rests at the sides of a clearly modelled nose. -->
      <path d="M166 197C167 217 163 231 146 239L113 250H287L254 239C237 231 233 217 234 197" fill="url(#{{ fit_art_id }}-neck)" stroke-opacity=".5"/>
      <path d="M106 89C91 77 86 91 92 111C94 124 99 134 109 137M294 89C309 77 314 91 308 111C306 124 301 134 291 137" fill="url(#{{ fit_art_id }}-skin)"/>
      <path d="M100 94C95 88 95 101 99 111L105 122M300 94C305 88 305 101 301 111L295 122" stroke-opacity=".42"/>
      <path d="M200-24C147-24 107 8 104 61C102 100 108 144 124 168C142 196 168 216 200 219C232 216 258 196 276 168C292 144 298 100 296 61C293 8 253-24 200-24Z" fill="url(#{{ fit_art_id }}-skin)"/>
      <ellipse cx="124" cy="141" rx="21" ry="53" fill="url(#{{ fit_art_id }}-shade)" stroke="none"/>
      <ellipse cx="276" cy="141" rx="21" ry="53" fill="url(#{{ fit_art_id }}-shade)" stroke="none"/>
      <ellipse cx="185" cy="118" rx="13" ry="31" fill="url(#{{ fit_art_id }}-shade)" stroke="none"/>
