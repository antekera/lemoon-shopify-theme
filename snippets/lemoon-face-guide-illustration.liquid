      <path d="M274 101C273 91 281 85 288 89C298 94 299 106 294 119C289 133 281 142 274 140C269 137 270 129 271 124" fill="url(#{{ fit_art_id }}-skin)"/>
      <path d="M281 101C284 92 291 96 290 104C289 112 281 115 279 121M278 130C283 126 287 127 281 133" stroke-opacity=".45"/>
      <g stroke-width="2.7">
        <path d="M155 82C172 78 197 79 212 83C218 85 220 89 219 96L211 117C208 124 201 129 189 130C175 132 162 129 157 122C152 116 151 106 150 96L149 90C148 85 150 83 155 82ZM120 85C127 82 135 82 139 84C143 85 144 89 144 93L141 109C139 117 135 121 129 120C123 119 120 114 118 106L117 93C116 89 117 86 120 85ZM144 92C146 88 148 88 150 92M219 91L270 96C275 97 278 100 279 105"/>
      </g>
    {%- when 'temple' -%}
      <!-- Side view: a smooth nose/lip silhouette and one temple curve behind the ear. -->
