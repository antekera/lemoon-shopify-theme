{% doc %}
  Renders an icon from the Lucide library (https://lucide.dev).
  @param {string} icon - Icon name.
  @param {number} [size] - Icon size in pixels, defaults to 24.
  @param {string} [label] - Accessible label; omit for decorative icons.
  @example
  {% render 'lemoon-icon', icon: 'search', size: 24, label: 'Buscar' %}
{% enddoc %}
{%- assign icon_size = size | default: 24 -%}
<svg class="lemoon-icon lemoon-icon--{{ icon }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"{% if label %} role="img" aria-label="{{ label | escape }}"{% else %} aria-hidden="true" focusable="false"{% endif %}>
  {%- case icon -%}
