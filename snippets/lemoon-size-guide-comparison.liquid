    <g style="fill:var(--lemoon-surface-page)" fill-opacity=".65" stroke-width=".8">
      <circle cx="31.5" cy="69" r="1.8"/><circle cx="31.5" cy="76" r="1.8"/>
      <circle cx="288.55" cy="124.7" r="2.1"/><circle cx="288.28" cy="131.3" r="2.1"/>
    </g>
  </svg>
  </div>
  <ol class="lemoon-size-comparison__rows">
    {%- for key in comparison_keys -%}
      {%- liquid
        assign label_key = 'lemoon_pdp.' | append: key
        assign explanation_key = 'lemoon_size_guide.code_' | append: key
      -%}
      <li class="lemoon-size-comparison__row">
        <svg class="lemoon-size-comparison__icon" viewBox="0 0 64 40" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          {%- case key -%}
            {%- when 'lens_width', 'bridge' -%}
              <g transform="translate(0 3) scale(.16)">
                <path d="M17.51 63.4C48.31 57.8 86.74 53.47 124.41 56.27C151.9 57.29 164.11 60.6 172.26 67.73C180.66 74.09 181.93 80.96 188.8 82.74C194.91 84.78 209.42 84.78 215.78 82.49C221.63 80.71 223.16 74.09 231.31 67.73C240.21 60.09 252.94 57.04 279.41 56.02C317.59 53.73 355 58.05 381.47 63.14Q383.25 63.65 383 81.72Q383 85.54 377.66 87.32Q371.55 89.11 369.26 95.21C366.97 106.16 366.71 119.9 361.11 144.85C356.53 163.93 350.68 174.12 341.77 179.21C328.28 187.1 285.01 189.64 264.9 184.81C244.03 182.01 235.38 177.17 229.52 168.01C220.87 154.52 215.02 133.14 210.94 111.5C209.67 103.87 207.64 101.32 202.04 100.56L198.22 100.56C192.36 100.81 189.56 103.87 188.29 109.72C183.46 133.14 177.09 155.28 167.68 168.26C161.31 177.93 153.68 181.75 134.08 185.06C110.66 189.9 72.49 186.33 59.5 181.75C49.58 178.44 43.72 171.06 38.89 159.61C31.51 141.03 29.98 115.58 29.47 98.52C29.22 92.92 27.44 89.11 21.58 86.82Q16.75 84.52 16.49 81.22L17 67.47Q17 64.67 17.51 63.4Z M101.25 64.67C126.7 63.91 149.61 65.18 161.31 72.82C170.22 78.92 175.06 88.09 175.06 100.56C175.06 113.03 169.97 132.88 163.6 150.95C159.02 164.19 154.44 171.32 144.77 174.62C128.23 180.22 83.18 182.26 64.6 174.88C52.12 170.3 47.54 159.35 44.74 145.61C40.67 131.1 39.4 113.03 39.91 100.3C40.42 86.31 44.74 78.16 52.38 72.82C63.58 66.45 82.16 64.67 101.25 64.67Z" fill="currentColor" fill-opacity=".18" fill-rule="evenodd" stroke-width="8"/>
                <path d="M101.25 64.67C126.7 63.91 149.61 65.18 161.31 72.82C170.22 78.92 175.06 88.09 175.06 100.56C175.06 113.03 169.97 132.88 163.6 150.95C159.02 164.19 154.44 171.32 144.77 174.62C128.23 180.22 83.18 182.26 64.6 174.88C52.12 170.3 47.54 159.35 44.74 145.61C40.67 131.1 39.4 113.03 39.91 100.3C40.42 86.31 44.74 78.16 52.38 72.82C63.58 66.45 82.16 64.67 101.25 64.67Z" transform="translate(400 0) scale(-1 1)" style="fill:var(--lemoon-surface-page)" fill-opacity=".9" stroke-width="8"/>
              </g>
              {%- if key == 'lens_width' -%}<path d="M6.35 5H28.02M6.35 2V8M28.02 2V8" stroke-width="1.2"/>{%- else -%}<path d="M28.02 5H35.98M28.02 2V8M35.98 2V8" stroke-width="1.2"/>{%- endif -%}
            {%- when 'temple' -%}
              <path d="M4 17L40 12Q49 10 54 19L60 31Q61 34 58 35Q56 36 54 33L48 23Q45 18 40 19L4 23Z" fill="currentColor" fill-opacity=".2" stroke-width="1.3"/>
              <path d="M7 19L40 15Q47 14 51 21" style="stroke:var(--lemoon-surface-page)" stroke-width="1"/>
              <path d="M7 8L39 3Q49 1 56 12L63 26M5 5L9 11" stroke-width="1.1"/>
          {%- endcase -%}
        </svg>
        <div class="lemoon-size-comparison__detail">
          <p class="lemoon-size-comparison__code">{% if key == 'lens_width' %}<strong>52</strong>{% else %}52{% endif %} □ {% if key == 'bridge' %}<strong>18</strong>{% else %}18{% endif %}–{% if key == 'temple' %}<strong>145</strong>{% else %}145{% endif %}</p>
          <p class="lemoon-size-comparison__definition"><span>{{ label_key | t }}</span>{{ explanation_key | t }}</p>
        </div>
      </li>
    {%- endfor -%}
  </ol>
  <p class="lemoon-size-comparison__footer">{{ 'lemoon_size_guide.no_code' | t }}</p>
</div>
