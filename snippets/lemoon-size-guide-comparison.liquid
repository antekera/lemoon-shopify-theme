{% doc %}
  Educational temple inscription, independent of product measurements.
  @param {string} instance_id - Unique prefix for the comparison heading.
  @param {number} [heading_level] - Semantic heading level, default 2.
  @param {boolean} [show_heading] - Show the heading unless false.
  @param {boolean} [compact] - Use the compact drawer composition.
{% enddoc %}
{%- liquid
  assign comparison_level = heading_level | default: 2
  assign comparison_title = 'lemoon_size_guide.comparison_title' | t
  assign comparison_heading_id = 'SizeComparison-' | append: instance_id
  assign comparison_keys = 'lens_width,bridge,temple' | split: ','
-%}
<div class="lemoon-size-comparison{% if compact %} lemoon-size-comparison--compact{% endif %}">
  {%- unless show_heading == false -%}
    {% render 'lemoon-ui-heading', text: comparison_title, level: comparison_level, id: comparison_heading_id %}
  {%- endunless -%}
  <p class="lemoon-size-comparison__intro">{{ 'lemoon_size_guide.comparison_intro' | t }}</p>
  <p class="lemoon-size-comparison__example-label">{{ 'lemoon_size_guide.example' | t }} <span class="lemoon-size-comparison__code">52 □ 18–145</span></p>
  <p class="lemoon-size-comparison__note">{{ 'lemoon_size_guide.educational_note' | t }}</p>
  <svg class="lemoon-size-comparison__temple" viewBox="8 12 408 260" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <path d="M30 120L177 34Q197 23 209 35L244 70Q248 75 244 79Q240 83 236 77L203 44Q195 37 181 44L35 133Z" fill="currentColor" fill-opacity=".07" stroke-width="1.4"/>
    <path d="M300 181L379 95Q389 87 394 100L401 126Q402 134 397 135Q392 136 390 129L385 111L303 196Z" fill="currentColor" fill-opacity=".07" stroke-width="1.4"/>
    <g transform="matrix(.74 .18 -.03 .82 20 42)">
      <path d="M49 74H151C168 74 177 84 177 94Q200 82 223 94C223 84 232 74 249 74H351C368 74 377 84 377 101V142C377 160 365 168 348 168H252C235 168 223 160 223 142V108Q200 96 177 108V142C177 160 165 168 148 168H52C35 168 23 160 23 142V101C23 84 32 74 49 74Z M51 84H149Q166 84 166 101V143Q166 158 149 158H51Q34 158 34 143V101Q34 84 51 84Z M251 84H349Q366 84 366 101V143Q366 158 349 158H251Q234 158 234 143V101Q234 84 251 84Z" fill="currentColor" fill-opacity=".07" fill-rule="evenodd" stroke-width="1.6"/>
      <path d="M17 88H23V103H17Z M377 88H383V103H377Z" fill="currentColor" fill-opacity=".07" stroke-width="1.3"/>
    </g>
    <path d="M321 170L377 112" stroke-width="1.1" stroke-dasharray="2 3"/>
  </svg>
  <ol class="lemoon-size-comparison__rows">
    {%- for key in comparison_keys -%}
      {%- liquid
        assign label_key = 'lemoon_pdp.' | append: key
        assign explanation_key = 'lemoon_size_guide.code_' | append: key
      -%}
      <li class="lemoon-size-comparison__row">
        <svg class="lemoon-size-comparison__icon" viewBox="0 0 64 40" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          {%- case key -%}
            {%- when 'lens_width', 'bridge' -%}
              <path d="M10 12H23Q28 12 28 17Q32 14 36 17Q36 12 41 12H54Q59 12 59 17V25Q59 30 54 30H41Q36 30 36 25V21Q32 18 28 21V25Q28 30 23 30H10Q5 30 5 25V17Q5 12 10 12Z M10 15H22Q25 15 25 18V24Q25 27 22 27H11Q8 27 8 24V18Q8 15 10 15Z M42 15H54Q56 15 56 18V24Q56 27 53 27H42Q39 27 39 24V18Q39 15 42 15Z" fill="currentColor" fill-opacity=".07" fill-rule="evenodd" stroke-width="1.3"/>
              {%- if key == 'lens_width' -%}<path d="M8 5H25M8 2V8M25 2V8" stroke-width="1.1"/>{%- else -%}<path d="M25 5H39M25 2V8M39 2V8" stroke-width="1.1"/>{%- endif -%}
            {%- when 'temple' -%}
              <path d="M4 17L42 13Q50 12 54 19L60 31Q62 34 58 35Q56 36 54 32L48 23Q46 20 41 21L4 23Z" fill="currentColor" fill-opacity=".07" stroke-width="1.3"/>
              <path d="M7 7L41 3Q51 1 56 12L63 27M5 4L9 10" stroke-width="1.1"/>
          {%- endcase -%}
        </svg>
        <div class="lemoon-size-comparison__detail">
          <p class="lemoon-size-comparison__code">{% if key == 'lens_width' %}<strong>52</strong>{% else %}52{% endif %} □ {% if key == 'bridge' %}<strong>18</strong>{% else %}18{% endif %}–{% if key == 'temple' %}<strong>145</strong>{% else %}145{% endif %}</p>
          <p class="lemoon-size-comparison__definition"><span>{{ label_key | t }}</span>{{ explanation_key | t }}</p>
        </div>
      </li>
    {%- endfor -%}
  </ol>
  <p class="lemoon-size-comparison__footer">{{ 'lemoon_size_guide.no_code' | t }}</p>
</div>
