    <path d="M23.18 57.88C56.45 62.83 97.15 73.83 123 94.18L134.28 104.08C141.98 108.48 155.18 109.85 162.33 107.38L169.2 102.15C180.75 93.35 243.18 102.98 297.08 116.45L299.83 118.65V131.03C294.88 135.43 289.1 137.35 286.62 142.58C284.15 155.5 282.5 184.65 272.88 200.88C267.1 211.88 257.2 213.53 242.08 213.8C219.8 213.53 199.18 207.48 186.8 201.15C172.5 194.55 168.38 182.18 162.05 164.85C154.62 145.33 153.8 136.25 148.58 128.82C145 123.05 141.98 120.85 138.68 120.03L138.12 128.55C136.48 145.33 133.45 159.9 126.03 167.05C121.63 172 115.3 173.38 107.05 172C87.53 169.25 61.12 157.98 51.23 148.9C43.53 142.3 38.02 130.2 33.62 115.08C27.85 96.93 24 81.8 22.62 69.15V62Q22.62 58.98 23.18 57.88Z" fill="url(#SizeCodeRim-{{ instance_id | escape }})" stroke-width="1.6"/>
    <path d="M50.67 71.08C68 70.53 102.38 80.43 115.03 91.15C123 98.3 127.13 108.75 127.68 119.48C128.78 130.75 126.03 147.25 119.15 158.53C115.85 163.48 110.9 166.5 104.3 165.12C85.88 162.65 64.7 152.2 55.35 144.23C48.48 137.9 44.08 128.28 39.67 115.35C34.17 99.12 30.88 81.53 36.65 75.47C39.95 72.18 44.62 71.08 50.67 71.08Z M180.48 107.1C210.45 107.38 252.25 115.63 273.15 125.25C281.12 128.82 285.25 135.43 284.43 143.95C283.6 158.25 280.03 183 273.98 192.62C269.02 203.35 263.8 207.2 255.83 207.75C234.1 207.75 207.7 199.78 195.05 192.35C184.05 186.03 178.28 173.38 173.6 159.9C167.83 143.68 163.7 126.63 168.1 115.63C169.75 110.13 173.88 107.1 180.48 107.1Z" fill="url(#SizeCodeLens-{{ instance_id | escape }})" stroke-width="1.15"/>
    <path d="M25.38 60.62C57 65.3 97.15 76.58 121.63 96.38L133.45 106.83C141.98 111.23 155.18 112.6 163.43 110.13L170.58 105.18C184.05 96.93 244 106.28 296.53 119.48" style="stroke:var(--lemoon-surface-page)" stroke-opacity=".68" stroke-width="1.05"/>
    <path d="M51.78 145.6C64.15 156.88 88.08 167.88 107.33 169.25Q119.7 172 124.93 164.3M187.62 198.13C202.2 206.38 226.4 212.15 242.35 211.33Q263.25 212.43 270.68 200.33" stroke-width="1.1" stroke-opacity=".5"/>
    <g style="fill:var(--lemoon-surface-page)" fill-opacity=".65" stroke-width=".8">
      <circle cx="27.03" cy="65.58" r="1.8"/><circle cx="27.03" cy="72.18" r="1.8"/>
      <circle cx="288.83" cy="124.43" r="2.1"/><circle cx="288.28" cy="131.03" r="2.1"/>
    </g>
  </svg>
  <ol class="lemoon-size-comparison__rows">
