                <path d="M101.25 64.67C126.7 63.91 149.61 65.18 161.31 72.82C170.22 78.92 175.06 88.09 175.06 100.56C175.06 113.03 169.97 132.88 163.6 150.95C159.02 164.19 154.44 171.32 144.77 174.62C128.23 180.22 83.18 182.26 64.6 174.88C52.12 170.3 47.54 159.35 44.74 145.61C40.67 131.1 39.4 113.03 39.91 100.3C40.42 86.31 44.74 78.16 52.38 72.82C63.58 66.45 82.16 64.67 101.25 64.67Z" transform="translate(400 0) scale(-1 1)" style="fill:var(--lemoon-surface-page)" fill-opacity=".9" stroke-width="8"/>
              </g>
              {%- if key == 'lens_width' -%}<path d="M6.35 5H28.02M6.35 2V8M28.02 2V8" stroke-width="1.2"/>{%- else -%}<path d="M28.02 5H35.98M28.02 2V8M35.98 2V8" stroke-width="1.2"/>{%- endif -%}
            {%- when 'temple' -%}
              <path d="M4 17L40 12Q49 10 54 19L60 31Q61 34 58 35Q56 36 54 33L48 23Q45 18 40 19L4 23Z" fill="currentColor" fill-opacity=".2" stroke-width="1.3"/>
              <path d="M7 19L40 15Q47 14 51 21" style="stroke:var(--lemoon-surface-page)" stroke-width="1"/>
              <path d="M7 8L39 3Q49 1 56 12L63 26M5 5L9 11" stroke-width="1.1"/>
          {%- endcase -%}
        </svg>
        <div class="lemoon-size-comparison__detail">
          <p class="lemoon-size-comparison__code">{% if key == 'lens_width' %}<strong>52</strong>{% else %}52{% endif %} □ {% if key == 'bridge' %}<strong>18</strong>{% else %}18{% endif %}–{% if key == 'temple' %}<strong>145</strong>{% else %}145{% endif %}</p>
          <p class="lemoon-size-comparison__definition"><span>{{ label_key | t }}</span>{{ explanation_key | t }}</p>
        </div>
      </li>
    {%- endfor -%}
  </ol>
  <p class="lemoon-size-comparison__footer">{{ 'lemoon_size_guide.no_code' | t }}</p>
</div>
