    <path d="M33.35 62.2C71.03 46.33 113.65 28.73 142.25 25.7C154.62 23.77 161.23 25.43 168.38 29" style="stroke:var(--lemoon-surface-page)" stroke-opacity=".65" stroke-width="1"/>
    <path d="M298.45 116.18L383.7 74.65C387.55 72.72 391.4 71.35 392.78 73.55C395.25 78.23 396.35 91.15 394.43 101.33C393.88 104.35 392.23 105.18 390.3 103.8C388.1 102.43 387.83 98.58 387.83 94.73L386.45 83.45Q385.9 82.08 384.53 83.18L304.23 135.15L299.28 137.9Z" fill="url(#SizeCodeRim-{{ instance_id | escape }})" stroke-width="1.5"/>
