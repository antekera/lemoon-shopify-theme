    <path d="M51.23 71.9C71.3 73.55 105.68 80.98 118.6 95C126.03 102.98 129.33 110.95 129.05 119.75C129.05 133.5 125.75 147.8 119.98 157.7C117.23 163.2 114.75 165.95 108.98 166.5C97.15 167.88 78.73 161.83 68.83 154.95C57.55 146.7 51.78 136.25 47.38 121.4C44.35 110.95 41.05 98.3 41.33 88.4C41.33 80.15 42.43 74.65 45.73 73Q47.65 71.62 51.23 71.9Z M185.43 106.28C204.68 105.18 253.08 113.43 274.8 123.88C282.23 127.45 284.98 134.32 282.5 145.88C279.48 162.1 276.45 185.75 271.23 193.73C267.1 201.7 259.95 203.08 249.78 201.7C226.68 200.6 204.95 192.9 195.6 185.75C187.63 179.15 183.78 165.95 180.75 153.03C178.55 143.4 177.73 136.8 174.15 131.03C170.58 125.8 168.93 121.4 169.2 117C170.03 109.85 174.98 106.83 185.43 106.28Z" fill="url(#SizeCodeLens-{{ instance_id | escape }})" stroke-width="1.15"/>
