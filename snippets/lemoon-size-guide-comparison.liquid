    <path d="M302.3 120.03L385.9 80.43Q389.2 78.22 391.13 79.88L390.58 84.83L301.75 131.3Z" style="fill:var(--lemoon-surface-page)" fill-opacity=".78" stroke-width=".8" stroke-opacity=".5"/>
