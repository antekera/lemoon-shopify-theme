{% doc %}
  Educational temple inscription, independent of product measurements.
  @param {string} instance_id - Unique prefix for the comparison heading.
  @param {number} [heading_level] - Semantic heading level, default 2.
  @param {boolean} [show_heading] - Show the heading unless false.
  @param {boolean} [compact] - Use the compact drawer composition.
{% enddoc %}
{%- liquid
  assign comparison_level = heading_level | default: 2
  assign comparison_title = 'lemoon_size_guide.comparison_title' | t
  assign comparison_heading_id = 'SizeComparison-' | append: instance_id
  assign comparison_keys = 'lens_width,bridge,temple' | split: ','
-%}
<div class="lemoon-size-comparison{% if compact %} lemoon-size-comparison--compact{% endif %}">
  {%- unless show_heading == false -%}
    {% render 'lemoon-ui-heading', text: comparison_title, level: comparison_level, id: comparison_heading_id %}
  {%- endunless -%}
  <p class="lemoon-size-comparison__intro">{{ 'lemoon_size_guide.comparison_intro' | t }}</p>
  <p class="lemoon-size-comparison__example-label">{{ 'lemoon_size_guide.example' | t }} <span class="lemoon-size-comparison__code">52 □ 18–145</span></p>
  <p class="lemoon-size-comparison__note">{{ 'lemoon_size_guide.educational_note' | t }}</p>
  <svg class="lemoon-size-comparison__temple" viewBox="8 10 404 238" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <defs>
      <linearGradient id="SizeCodeRim-{{ instance_id | escape }}" x1="0" y1="0" x2=".25" y2="1">
        <stop stop-color="currentColor" stop-opacity=".64"/>
        <stop offset=".32" stop-color="currentColor" stop-opacity=".2"/>
        <stop offset=".62" stop-color="currentColor" stop-opacity=".12"/>
        <stop offset="1" stop-color="currentColor" stop-opacity=".6"/>
      </linearGradient>
      <linearGradient id="SizeCodeLens-{{ instance_id | escape }}" x1="0" y1="0" x2="1" y2="1">
        <stop style="stop-color:var(--lemoon-surface-page)" stop-opacity=".99"/>
        <stop offset=".6" style="stop-color:var(--lemoon-surface-page)" stop-opacity=".96"/>
        <stop offset="1" style="stop-color:var(--lemoon-surface-page)" stop-opacity=".85"/>
      </linearGradient>
    </defs>
    <path d="M32 79C79 60 128 35 176 25C196 21 212 22 225 29C242 40 251 56 264 70Q268 76 263 80Q259 84 255 78L219 42Q207 31 186 34L36 93Z" fill="url(#SizeCodeRim-{{ instance_id | escape }})" fill-opacity=".65" stroke-opacity=".65" stroke-width="1.3"/>
    <path d="M39 80L185 29Q209 25 222 35" style="stroke:var(--lemoon-surface-page)" stroke-opacity=".7" stroke-width="1"/>
    <path d="M293 148L374 77C381 71 388 70 391 77L396 109Q396 116 391 118Q386 119 384 111L379 89L301 172Z" fill="url(#SizeCodeRim-{{ instance_id | escape }})" stroke-width="1.5"/>
    <path d="M303 151L375 86Q380 81 382 85L384 93L309 163Z" style="fill:var(--lemoon-surface-page)" fill-opacity=".78" stroke-width=".8" stroke-opacity=".5"/>
    <path d="M317 144L366 99" stroke-width="1.6" stroke-dasharray="2 3" stroke-opacity=".7"/>
    <path d="M30 78C63 77 110 90 130 108L145 126Q157 139 172 131L183 122C206 116 260 128 292 146L300 158C301 183 290 217 280 226C251 231 217 222 198 212C184 204 175 185 165 161Q155 150 144 153C139 171 133 188 124 193C102 193 69 184 51 173C39 163 33 121 30 100Z" transform="translate(0 3)" fill="currentColor" fill-opacity=".2" stroke-width="1" stroke-opacity=".5"/>
    <path d="M30 78C63 77 110 90 130 108L145 126Q157 139 172 131L183 122C206 116 260 128 292 146L300 158C301 183 290 217 280 226C251 231 217 222 198 212C184 204 175 185 165 161Q155 150 144 153C139 171 133 188 124 193C102 193 69 184 51 173C39 163 33 121 30 100Z" fill="url(#SizeCodeRim-{{ instance_id | escape }})" stroke-width="1.7"/>
    <path d="M44 94C65 93 98 103 115 114C127 122 135 133 135 145C134 161 128 177 120 181C102 182 76 173 60 165C49 158 45 132 44 111Z M193 137C215 133 254 143 278 155C284 161 286 168 284 179C280 197 275 212 268 216C247 219 219 210 205 202C194 194 184 174 183 156C182 147 186 140 193 137Z" fill="url(#SizeCodeLens-{{ instance_id | escape }})" stroke-width="1.2"/>
    <path d="M35 81C66 82 110 94 127 111L144 129Q159 142 174 134L186 125C210 121 260 134 289 149" style="stroke:var(--lemoon-surface-page)" stroke-opacity=".78" stroke-width="1.15"/>
    <path d="M58 169C77 180 105 188 122 187M201 207C220 217 253 225 276 221M143 151Q156 143 168 156" stroke-width="1.15" stroke-opacity=".6"/>
    <path d="M32 88L39 90L42 108L35 107Z M289 153L298 155L299 171L291 169Z" fill="currentColor" fill-opacity=".35" stroke-width=".9"/>
    <circle cx="37" cy="98" r="2" fill="currentColor" fill-opacity=".3" stroke-width=".8"/>
    <circle cx="295" cy="162" r="2.4" fill="currentColor" fill-opacity=".3" stroke-width=".8"/>
    <circle cx="305" cy="154" r="1.8" stroke-width=".8"/>
  </svg>
  <ol class="lemoon-size-comparison__rows">
    {%- for key in comparison_keys -%}
      {%- liquid
        assign label_key = 'lemoon_pdp.' | append: key
        assign explanation_key = 'lemoon_size_guide.code_' | append: key
      -%}
      <li class="lemoon-size-comparison__row">
        <svg class="lemoon-size-comparison__icon" viewBox="0 0 64 40" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          {%- case key -%}
            {%- when 'lens_width', 'bridge' -%}
              <path d="M3 13Q15 8 25 11L30 16Q32 17 34 16L39 11Q49 8 61 13L59 27Q58 31 54 32L42 32Q38 31 36 24L34 20Q32 18 30 20L28 24Q26 31 22 32L10 32Q6 31 5 27Z" fill="currentColor" fill-opacity=".18" stroke-width="1.3"/>
              <path d="M8 16Q15 13 22 15Q26 16 26 20Q25 27 22 28L11 28Q8 27 8 16Z M56 16Q49 13 42 15Q38 16 38 20Q39 27 42 28L53 28Q56 27 56 16Z" style="fill:var(--lemoon-surface-page)" fill-opacity=".9" stroke-width="1"/>
              {%- if key == 'lens_width' -%}<path d="M8 5H26M8 2V8M26 2V8" stroke-width="1.2"/>{%- else -%}<path d="M26 5H38M26 2V8M38 2V8" stroke-width="1.2"/>{%- endif -%}
            {%- when 'temple' -%}
              <path d="M4 17L40 12Q49 10 54 19L60 31Q61 34 58 35Q56 36 54 33L48 23Q45 18 40 19L4 23Z" fill="currentColor" fill-opacity=".2" stroke-width="1.3"/>
              <path d="M7 19L40 15Q47 14 51 21" style="stroke:var(--lemoon-surface-page)" stroke-width="1"/>
              <path d="M7 8L39 3Q49 1 56 12L63 26M5 5L9 11" stroke-width="1.1"/>
          {%- endcase -%}
        </svg>
        <div class="lemoon-size-comparison__detail">
          <p class="lemoon-size-comparison__code">{% if key == 'lens_width' %}<strong>52</strong>{% else %}52{% endif %} □ {% if key == 'bridge' %}<strong>18</strong>{% else %}18{% endif %}–{% if key == 'temple' %}<strong>145</strong>{% else %}145{% endif %}</p>
          <p class="lemoon-size-comparison__definition"><span>{{ label_key | t }}</span>{{ explanation_key | t }}</p>
        </div>
      </li>
    {%- endfor -%}
  </ol>
  <p class="lemoon-size-comparison__footer">{{ 'lemoon_size_guide.no_code' | t }}</p>
</div>
