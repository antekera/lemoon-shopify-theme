{% doc %}
  Renders the editable two-level navigation drawer.
  @param {section} section - Header section with navigation blocks and settings.
  @example
  {% render 'lemoon-mobile-nav', section: section %}
{% enddoc %}
{{ 'lemoon-mobile-nav.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lemoon-mobile-nav.js' | asset_url }}" defer="defer"></script>
<div class="lemoon-mobile-nav__overlay" data-lemoon-nav-overlay aria-hidden="true"></div>
<div class="lemoon-mobile-nav" id="lemoon-mobile-nav" data-lemoon-nav role="dialog" aria-label="{{ 'sections.header.menu' | t }}" aria-hidden="true" tabindex="-1" inert>
  <div class="lemoon-mobile-nav__panel" data-lemoon-nav-root>
    <nav aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="lemoon-mobile-nav__primary" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'drawer_primary' and block.settings.title != blank -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.has_submenu == false and block.settings.link != blank -%}
                <a class="lemoon-mobile-nav__primary-button" href="{{ block.settings.link }}">
                  {%- if block.settings.icon != 'none' -%}{% render 'lemoon-icon', icon: block.settings.icon, size: 23 %}{%- endif -%}
                  <span>{{ block.settings.title | escape }}</span>
                </a>
              {%- else -%}
                <button type="button" class="lemoon-mobile-nav__primary-button" data-lemoon-nav-target="{{ block.settings.slot | escape }}">
                  {%- if block.settings.icon != 'none' -%}{% render 'lemoon-icon', icon: block.settings.icon, size: 23 %}{%- endif -%}
                  <span>{{ block.settings.title | escape }}</span>
                  {% render 'lemoon-icon', icon: 'chevron-right', size: 18 %}
                </button>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>
    <nav class="lemoon-mobile-nav__utility" aria-label="{{ section.settings.utility_heading | escape }}">
      <ul role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'drawer_utility' and block.settings.title != blank and block.settings.link != blank -%}
            <li {{ block.shopify_attributes }}><a href="{{ block.settings.link }}">
              {%- if block.settings.icon != 'none' -%}{% render 'lemoon-icon', icon: block.settings.icon, size: 20 %}{%- endif -%}
              <span>{{ block.settings.title | escape }}</span>
            </a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>
    <div class="lemoon-mobile-nav__account">
      <p>{{ section.settings.account_message | escape }}</p>
      <div class="lemoon-mobile-nav__account-actions">
        <a class="lemoon-mobile-nav__account-login" href="{{ routes.account_login_url }}">{{ section.settings.login_label | escape }}</a>
        <a class="lemoon-mobile-nav__account-register" href="{{ routes.account_register_url }}">{{ section.settings.register_label | escape }}</a>
      </div>
    </div>
  </div>
  {%- for primary in section.blocks -%}
    {%- if primary.type == 'drawer_primary' and primary.settings.title != blank and primary.settings.has_submenu -%}
      <div class="lemoon-mobile-nav__panel" data-lemoon-nav-panel="{{ primary.settings.slot | escape }}" aria-hidden="true" tabindex="-1" hidden>
        <h2 class="lemoon-mobile-nav__subheading">{{ primary.settings.title | escape }}</h2>
        <nav aria-label="{{ primary.settings.title | escape }}">
          <ul class="lemoon-mobile-nav__sublist" role="list">
            {%- if primary.settings.link != blank -%}<li><a href="{{ primary.settings.link }}">{{ section.settings.view_all_label | escape }}</a></li>{%- endif -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'drawer_subitem' and block.settings.parent == primary.settings.slot and block.settings.group == 'featured' and block.settings.title != blank and block.settings.link != blank -%}
                {% render 'lemoon-mobile-nav-link', block: block %}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </nav>
        {%- capture shape_links -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'drawer_subitem' and block.settings.parent == primary.settings.slot and block.settings.group == 'shape' -%}
              {% render 'lemoon-mobile-nav-link', block: block %}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- assign shape_links = shape_links | strip -%}
        {%- if shape_links != blank -%}
          <nav class="lemoon-mobile-nav__subgroup" aria-label="{{ section.settings.shape_heading | escape }}">
            <h3>{{ section.settings.shape_heading | escape }}</h3>
            <ul class="lemoon-mobile-nav__sublist" role="list">{{ shape_links }}</ul>
          </nav>
        {%- endif -%}
        {%- capture color_links -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'drawer_subitem' and block.settings.parent == primary.settings.slot and block.settings.group == 'color' -%}
              {% render 'lemoon-mobile-nav-link', block: block %}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- assign color_links = color_links | strip -%}
        {%- if color_links != blank -%}
          <nav class="lemoon-mobile-nav__subgroup" aria-label="{{ section.settings.color_heading | escape }}">
            <h3>{{ section.settings.color_heading | escape }}</h3>
            <ul class="lemoon-mobile-nav__sublist" role="list">{{ color_links }}</ul>
          </nav>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>
