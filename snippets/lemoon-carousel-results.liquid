{% doc %}
  Product list for collection carousel responses. Templates own pagination and view identity.
  @param {product[]} products - Current native collection page products.
  @param {string} [next_url] - Native paginate.next.url, absent on final page.
  @param {string} section_id - Card namespace for the response view.
  @param {boolean} [show_quick_add] - Native card quick add; true for accessory responses only.
{% enddoc %}
<ul class="lemoon-featured-products__results" data-next-page="{{ next_url | escape }}">
  {%- for card_product in products -%}
    {%- if card_product.price > 0 and card_product.available -%}
      <li class="lemoon-featured-products__item" data-product-id="{{ card_product.id }}" data-product-tags="{{ card_product.tags | json | escape }}">
        {% render 'card-product', card_product: card_product, media_aspect_ratio: 'square', show_secondary_image: true, show_vendor: false, show_rating: false, lazy_load: true, skip_styles: true, section_id: section_id, show_quick_add: show_quick_add %}
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
