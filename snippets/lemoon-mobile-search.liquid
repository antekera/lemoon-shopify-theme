{% doc %}
  Renders the mobile product search panel and its initial product data.
  @param {section} section - Header section containing the content settings.
  @example
  {% render 'lemoon-mobile-search', section: section %}
{% enddoc %}
<script type="module" src="{{ 'lemoon-mobile-search.js' | asset_url | escape }}"></script>
{%- liquid
  assign panel_id = 'Lemoon-Mobile-Search-' | append: section.id
  assign information_keys = 'shipping_returns,faq,find_style' | split: ','
  assign information_settings = 'mobile_search_shipping_page,mobile_search_faq_page,mobile_search_style_page' | split: ','
  assign information_icons = 'truck,circle-help,sparkles' | split: ','
  assign trend_count = 0
  for index in (1..4)
    assign setting_id = 'mobile_search_trending_product_' | append: index
    if section.settings[setting_id] != blank
      assign trend_count = trend_count | plus: 1
    endif
  endfor
-%}
<div class="lemoon-mobile-search" data-lemoon-search hidden
  data-search-url="{{ routes.search_url | escape }}"
  data-predictive-url="{{ routes.predictive_search_url | escape }}"
  data-loading="{{ 'sections.mobile_search.loading' | t | escape }}"
  data-no-results="{{ 'sections.mobile_search.no_results' | t: terms: '__TERMS__' | escape }}"
  data-error="{{ 'sections.mobile_search.error' | t | escape }}"
  data-results-count="{{ 'sections.mobile_search.results_count' | t: count: '__COUNT__' | escape }}">
  <div class="lemoon-mobile-search__overlay" data-lemoon-search-overlay aria-hidden="true"></div>
  <div id="{{ panel_id }}" class="lemoon-mobile-search__panel" data-lemoon-search-panel role="dialog" aria-modal="true" aria-labelledby="{{ panel_id }}-Title" tabindex="-1">
    <div class="lemoon-mobile-search__heading">
      <button type="button" class="lemoon-mobile-search__close" data-lemoon-search-close aria-label="{{ 'sections.mobile_search.close' | t }}">
        {% render 'lemoon-icon', icon: 'chevron-right', size: 24 %}
      </button>
      <h2 id="{{ panel_id }}-Title">{{ 'sections.mobile_search.title' | t }}</h2>
    </div>
    <form action="{{ routes.search_url }}" method="get" role="search" class="lemoon-mobile-search__form" data-lemoon-search-form>
      <label class="visually-hidden" for="{{ panel_id }}-Input">{{ 'sections.mobile_search.search_label' | t }}</label>
      <input id="{{ panel_id }}-Input" class="lemoon-mobile-search__input" data-lemoon-search-input type="search" name="q" placeholder="{{ 'sections.mobile_search.placeholder' | t }}" autocomplete="off" aria-controls="{{ panel_id }}-Results">
      <input type="hidden" name="type" value="product">
      <button type="submit" class="lemoon-mobile-search__submit" aria-label="{{ 'sections.mobile_search.submit' | t }}">{% render 'lemoon-icon', icon: 'search', size: 24 %}</button>
    </form>
    <a class="lemoon-mobile-search__show-all" href="{{ routes.search_url }}?type=product" data-lemoon-search-all>{{ 'sections.mobile_search.show_all' | t }} {% render 'lemoon-icon', icon: 'arrow-right', size: 18 %}</a>
    <section class="lemoon-mobile-search__suggestions" aria-labelledby="{{ panel_id }}-Suggested">
      <h3 id="{{ panel_id }}-Suggested">{{ 'sections.mobile_search.suggested_products' | t }}</h3>
      <p class="lemoon-mobile-search__status" role="status" aria-live="polite" aria-atomic="true" data-lemoon-search-status></p>
      <ul id="{{ panel_id }}-Results" class="lemoon-mobile-search__results" data-lemoon-search-results aria-busy="false" role="list"></ul>
    </section>
    <section class="lemoon-mobile-search__information" aria-labelledby="{{ panel_id }}-Information">
      <h3 id="{{ panel_id }}-Information">{{ 'sections.mobile_search.information' | t }}</h3>
      <ul class="lemoon-mobile-search__information-links" role="list">
        {%- for setting_id in information_settings -%}
          {%- assign information_page = section.settings[setting_id] -%}
          {%- if information_page != blank -%}
            {%- assign translation_key = 'sections.mobile_search.' | append: information_keys[forloop.index0] -%}
            <li><a href="{{ information_page.url | escape }}">{% render 'lemoon-icon', icon: information_icons[forloop.index0], size: 22 %}<span>{{ translation_key | t }}</span>{% render 'lemoon-icon', icon: 'chevron-right', size: 18 %}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </section>
    <section class="lemoon-mobile-search__trends" aria-labelledby="{{ panel_id }}-Trends">
      <h3 id="{{ panel_id }}-Trends">{{ 'sections.mobile_search.trends' | t }}</h3>
      {%- if section.settings.mobile_search_banner_image != blank and section.settings.mobile_search_banner_url != blank -%}
        {%- assign banner_alt = section.settings.mobile_search_banner_image.alt | default: '' -%}
        {%- if banner_alt == blank -%}{%- assign banner_alt = 'sections.mobile_search.banner_alt' | t -%}{%- endif -%}
        <a class="lemoon-mobile-search__banner" href="{{ section.settings.mobile_search_banner_url | escape }}">
          {{ section.settings.mobile_search_banner_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '320, 480, 750, 1000', sizes: '(max-width: 989px) 100vw, 480px', alt: banner_alt }}
        </a>
      {%- endif -%}
      {%- if trend_count > 0 -%}
        <div class="lemoon-mobile-search__carousel" data-lemoon-search-carousel>
          <div data-lemoon-search-slides>
            {%- assign slide_index = 0 -%}
            {%- for index in (1..4) -%}
              {%- assign setting_id = 'mobile_search_trending_product_' | append: index -%}
              {%- assign trend_product = section.settings[setting_id] -%}
              {%- if trend_product != blank -%}
                <div class="lemoon-mobile-search__slide" data-lemoon-search-slide data-slide-index="{{ slide_index }}"{% if slide_index > 0 %} hidden{% endif %}>
                  <a class="lemoon-mobile-search__product" href="{{ trend_product.url | escape }}">
                    {%- if trend_product.featured_image != blank -%}
                      {{ trend_product.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '96px', alt: trend_product.title }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'lemoon-mobile-search__placeholder' }}
                    {%- endif -%}
                    <span>{{ trend_product.title | escape }}</span>{% render 'lemoon-icon', icon: 'arrow-right', size: 20 %}
                  </a>
                </div>
                {%- assign slide_index = slide_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="lemoon-mobile-search__carousel-controls"{% if trend_count < 2 %} hidden{% endif %}>
            <button type="button" data-lemoon-search-previous aria-label="{{ 'sections.mobile_search.previous_product' | t }}">{% render 'lemoon-icon', icon: 'arrow-left', size: 20 %}</button>
            <div class="lemoon-mobile-search__dots">
              {%- for index in (1..trend_count) -%}
                <button type="button" data-lemoon-search-dot data-slide-index="{{ forloop.index0 }}" aria-label="{{ 'sections.mobile_search.slide_label' | t: index: index, total: trend_count }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"><span></span></button>
              {%- endfor -%}
            </div>
            <button type="button" data-lemoon-search-next aria-label="{{ 'sections.mobile_search.next_product' | t }}">{% render 'lemoon-icon', icon: 'arrow-right', size: 20 %}</button>
          </div>
        </div>
      {%- endif -%}
    </section>
  </div>
  <template data-lemoon-search-product-template>
    <li><a class="lemoon-mobile-search__product" data-product-link><span class="lemoon-mobile-search__product-image" data-product-image>{{ 'product-1' | placeholder_svg_tag: 'lemoon-mobile-search__placeholder' }}</span><span data-product-title></span>{% render 'lemoon-icon', icon: 'arrow-right', size: 18 %}</a></li>
  </template>
  <script type="application/json" data-lemoon-search-products>
    [
      {%- for initial_product in collections.all.products limit: 50 -%}
        {%- unless forloop.first -%},{%- endunless -%}
        {"id":{{ initial_product.id | json }},"url":{{ initial_product.url | json | replace: '<', '\u003c' | replace: '>', '\u003e' | replace: '&', '\u0026' }},"title":{{ initial_product.title | json | replace: '<', '\u003c' | replace: '>', '\u003e' | replace: '&', '\u0026' }},"image":{% if initial_product.featured_image != blank %}{{ initial_product.featured_image | image_url: width: 240 | json | replace: '<', '\u003c' | replace: '>', '\u003e' | replace: '&', '\u0026' }}{% else %}null{% endif %}}
      {%- endfor -%}
    ]
  </script>
</div>
