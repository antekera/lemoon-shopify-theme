{% comment %}
  Small confirmation toast shown after an item is added to the cart.
{% endcomment %}

<cart-notification>
  <div
    id="cart-notification"
    class="cart-notification"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    aria-hidden="true"
  >
    <span class="cart-notification__icon" aria-hidden="true">
      {{- 'icon-checkmark.svg' | inline_asset_content -}}
    </span>
    <p class="cart-notification__message">
      <span id="cart-notification-product" class="cart-notification-product__name"></span>
      &#32;<span>{{ 'sections.cart_notification.added' | t }}</span>
    </p>
    <a class="cart-notification__checkout" href="{{ routes.root_url }}checkout">{{ 'sections.cart_notification.checkout' | t }}</a>
    <button
      type="button"
      class="cart-notification__close"
      aria-label="{{ 'accessibility.close' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>
  </div>
</cart-notification>
